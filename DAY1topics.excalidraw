      "seed": 1957381740,
      "version": 39,
      "versionNonce": 729203284,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784511935472,
      "link": null,
      "locked": false,
      "text": "Characteristics\n✅ Callback immediately execute nahi hota.\n✅ Pehle async operation complete hota hai.\n✅ Event Loop callback ko Call Stack me bhejta hai.\n✅ JavaScript beech me doosra kaam karti rehti hai.\n✅ Program block nahi hota.",
      "fontSize": 21.523809523809508,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Characteristics\n✅ Callback immediately execute nahi hota.\n✅ Pehle async operation complete hota hai.\n✅ Event Loop callback ko Call Stack me bhejta hai.\n✅ JavaScript beech me doosra kaam karti rehti hai.\n✅ Program block nahi hota.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
