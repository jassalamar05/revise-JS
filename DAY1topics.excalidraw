      "text": "Value\n\n↓\n\nPrimitive hai?\n      │\n ┌────┴────┐\n │         │\nYES       NO (Object)\n │         │\n │         ▼\n │   Symbol.toPrimitive ?\n │         │\n │     ┌───┴───┐\n │     │       │\n │    YES     NO\n │     │       │\n │     ▼       ▼\n │  Call it   Hint check\n │             │\n │      ┌──────┴──────┐\n │      │             │\n │    \"string\"      \"number\"/\"default\"\n │      │             │\n │      ▼             ▼\n │ toString()      valueOf()\n │      │             │\n │ Primitive?     Primitive?\n │      │             │\n │   YES│         YES │\n │      ▼             ▼\n │   Return       Return\n │      │             │\n │   NO ▼         NO  ▼\n │ valueOf()     toString()\n │      │             │\n │ Primitive?     Primitive?\n │      │             │\n │   YES│         YES │\n │      ▼             ▼\n │   Return       Return\n │\n └──────────────► TypeError (if neither returns primitive)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Value\n\n↓\n\nPrimitive hai?\n      │\n ┌────┴────┐\n │         │\nYES       NO (Object)\n │         │\n │         ▼\n │   Symbol.toPrimitive ?\n │         │\n │     ┌───┴───┐\n │     │       │\n │    YES     NO\n │     │       │\n │     ▼       ▼\n │  Call it   Hint check\n │             │\n │      ┌──────┴──────┐\n │      │             │\n │    \"string\"      \"number\"/\"default\"\n │      │             │\n │      ▼             ▼\n │ toString()      valueOf()\n │      │             │\n │ Primitive?     Primitive?\n │      │             │\n │   YES│         YES │\n │      ▼             ▼\n │   Return       Return\n │      │             │\n │   NO ▼         NO  ▼\n │ valueOf()     toString()\n │      │             │\n │ Primitive?     Primitive?\n │      │             │\n │   YES│         YES │\n │      ▼             ▼\n │   Return       Return\n │\n └──────────────► TypeError (if neither returns primitive)",
