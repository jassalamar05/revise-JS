    {
      "id": "nFAS3ugxqmddd7CW0hjkf",
      "type": "text",
      "x": 28829.504049028663,
      "y": 2172.19300495107,
      "width": 263.89984130859375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
