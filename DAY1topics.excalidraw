    {
      "id": "fBypcrW8a8tqenhmb9CG9",
      "type": "text",
      "x": 47573.71957211623,
      "y": 8033.073654973597,
      "width": 1154.8174927185903,
      "height": 233.43749999999824,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bLW",
