      "seed": 1541680127,
      "version": 222,
      "versionNonce": 1097471441,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784078528625,
      "link": null,
      "locked": false,
      "text": "Boolean : yeh basically kya hai -> aise values jo convert hongi appki boolean mei ie \n\ntrue or flase .\n\n\nTruthy values       &&      Falsy values ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Boolean : yeh basically kya hai -> aise values jo convert hongi appki boolean mei ie \n\ntrue or flase .\n\n\nTruthy values       &&      Falsy values ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Pgmvjo0J2TuIorZgmyt6U",
      "type": "text",
      "x": 13201.841407957538,
      "y": 17194.88349762196,
      "width": 1988.5673828125,
      "height": 180,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5x",
      "roundness": null,
      "seed": 121813873,
      "version": 133,
      "versionNonce": 895918207,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784079555366,
      "link": null,
      "locked": false,
      "text": "jab ham value ko boolean context mei dekhte hai agar woh TRUTHY value hui toh true nai toh falsy value - false\n\n\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "jab ham value ko boolean context mei dekhte hai agar woh TRUTHY value hui toh true nai toh falsy value - false\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "71XjD0kepe93NU0EO9Nzw",
      "type": "text",
      "x": 13691.841407957538,
      "y": 17379.883472190642,
      "width": 503.2767125813211,
      "height": 840.1216683288698,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5z",
      "roundness": null,
      "seed": 661255487,
      "version": 97,
      "versionNonce": 523712401,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784079586408,
      "link": null,
      "locked": false,
      "text": "Is it undefined?   ❌ No\nIs it null?        ❌ No\nIs it false?       ❌ No\nIs it +0?          ❌ No\nIs it -0?          ❌ No\nIs it 0n?          ❌ No\nIs it NaN?         ❌ No\nIs it \"\" ?         ❌ No\n\n↓\n\nKuch bhi falsy nahi mila\n\n↓\n\nReturn true",
      "fontSize": 42.00608341644351,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Is it undefined?   ❌ No\nIs it null?        ❌ No\nIs it false?       ❌ No\nIs it +0?          ❌ No\nIs it -0?          ❌ No\nIs it 0n?          ❌ No\nIs it NaN?         ❌ No\nIs it \"\" ?         ❌ No\n\n↓\n\nKuch bhi falsy nahi mila\n\n↓\n\nReturn true",
      "autoResize": true,
      "lineHeight": 1.25
    },
