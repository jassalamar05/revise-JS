    {
      "id": "HNl93mUzqEjpCfVoeWtIy",
      "type": "text",
      "x": 45808.20165814299,
      "y": -6728.4632246568,
      "width": 1261.439208984375,
      "height": 650,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
