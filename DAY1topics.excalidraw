      "updated": 1783258272314,
      "link": null,
      "locked": false,
      "text": "Kya hua?\nintroduce.call(user1, \"Delhi\");\n\nJavaScript internally aise sochti hai:\n\nthis = user1\n\nAur jab:\n\nintroduce.call(user2, \"Mumbai\");\n\nJavaScript sochti hai:\n\nthis = user2",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kya hua?\nintroduce.call(user1, \"Delhi\");\n\nJavaScript internally aise sochti hai:\n\nthis = user1\n\nAur jab:\n\nintroduce.call(user2, \"Mumbai\");\n\nJavaScript sochti hai:\n\nthis = user2",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
