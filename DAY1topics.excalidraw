      "seed": 1827527259,
      "version": 316,
      "versionNonce": 969529179,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785247567178,
      "link": null,
      "locked": false,
      "text": "\nConstructor ek special method hota hai jo class ke andar define kiya jata hai. Jab bhi new keyword se object create \nhota hai, constructor \nautomatically call ho jata hai aur us naye object ko initialize karta hai, yani uski properties ko initial values\n assign karta hai.",
      "fontSize": 38.45036100725861,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nConstructor ek special method hota hai jo class ke andar define kiya jata hai. Jab bhi new keyword se object create \nhota hai, constructor \nautomatically call ho jata hai aur us naye object ko initialize karta hai, yani uski properties ko initial values\n assign karta hai.",
      "autoResize": true,
      "lineHeight": 1.25
    },
