    },
    {
      "id": "nt74WYvcc5_2qTNtYOqL1",
      "type": "text",
      "x": 25622.346248651666,
      "y": 6669.286801727749,
      "width": 1638.1947021484375,
      "height": 595,
      "angle": 0,
      "strokeColor": "#38d9a9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAa",
      "roundness": null,
      "seed": 488117199,
      "version": 48,
      "versionNonce": 1839925231,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784610643897,
      "link": null,
      "locked": false,
      "text": "| Feature       | Sequential Execution                                   | Parallel Execution                          |\n| ------------- | ------------------------------------------------------ | ------------------------------------------- |\n\n| Meaning       | Ek task complete hone ke baad next task start hota hai | Multiple tasks ek saath start hote hain     \n|\n| Start Time    | Next task wait karta hai                               | Sab tasks ek hi time par start ho jate hain |\n\n| Dependency    | Usually tasks ek dusre par depend hote hain            | Tasks independent hote hain                 |\n\n| Total Time    | Sab tasks ke time ka sum                               | Sabse slow task jitna time                  |\n\n| Speed         | Slow                                                   | Faster                                      |\n\n| `async/await` | Multiple `await` ek ke baad ek                         | `Promise.all()` ya similar methods          |\n\n| Use Case      |                                                        |                                             |\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "| Feature       | Sequential Execution                                   | Parallel Execution                          |\n| ------------- | ------------------------------------------------------ | ------------------------------------------- |\n\n| Meaning       | Ek task complete hone ke baad next task start hota hai | Multiple tasks ek saath start hote hain     \n|\n| Start Time    | Next task wait karta hai                               | Sab tasks ek hi time par start ho jate hain |\n\n| Dependency    | Usually tasks ek dusre par depend hote hain            | Tasks independent hote hain                 |\n\n| Total Time    | Sab tasks ke time ka sum                               | Sabse slow task jitna time                  |\n\n| Speed         | Slow                                                   | Faster                                      |\n\n| `async/await` | Multiple `await` ek ke baad ek                         | `Promise.all()` ya similar methods          |\n\n| Use Case      |                                                        |                                             |\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "36J1sg6BqCBUsRBWks4i4",
      "type": "rectangle",
