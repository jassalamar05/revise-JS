    {
      "id": "Y_BIqNYDKCoLK9hSfmUKV",
      "type": "text",
      "x": 9385.464254485802,
      "y": 17790.098999412232,
      "width": 2333.259728098978,
      "height": 159.8675241817927,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4M",
      "roundness": null,
      "seed": 1281679658,
      "version": 100,
      "versionNonce": 1071426026,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783454194798,
      "link": null,
      "locked": false,
      "text": "Function Declaration works before its declaration because the JavaScript engine stores the entire function\nduring the Memory Creation Phase. Function Expression does not work because only the variable is hoisted; the\nfunction is assigned later during the Execution Phase.",
      "fontSize": 42.631339781811384,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Function Declaration works before its declaration because the JavaScript engine stores the entire function during the Memory Creation Phase. Function Expression does not work because only the variable is hoisted; the function is assigned later during the Execution Phase.",
      "autoResize": false,
      "lineHeight": 1.25
    },
