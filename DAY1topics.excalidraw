      "text": "2. Infinite Sequence ✅\n\nInfinite Natural Numbers generate kar sakte ho bina ek hi baar sab memory me store kiye.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Infinite Sequence ✅\n\nInfinite Natural Numbers generate kar sakte ho bina ek hi baar sab memory me store kiye.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wg3z0suN_Dwyt5sAYFHAb",
      "type": "text",
      "x": 30087.22867520661,
      "y": 28976.559957353347,
      "width": 449.90374755859375,
      "height": 525,
      "angle": 0,
      "strokeColor": "#38d9a9",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bDT",
      "roundness": null,
      "seed": 1891563713,
      "version": 5,
      "versionNonce": 444100143,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784755465748,
      "link": null,
      "locked": false,
      "text": "function* natural() {\n    let i = 1;\n\n    while (true) {\n        yield i++;\n    }\n}\n\nAb\n\nconst num = natural();\n\nconsole.log(num.next().value); //1\nconsole.log(num.next().value); //2\nconsole.log(num.next().value); //3",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function* natural() {\n    let i = 1;\n\n    while (true) {\n        yield i++;\n    }\n}\n\nAb\n\nconst num = natural();\n\nconsole.log(num.next().value); //1\nconsole.log(num.next().value); //2\nconsole.log(num.next().value); //3",
      "autoResize": true,
      "lineHeight": 1.25
    },
