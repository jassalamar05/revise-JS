      "updated": 1785505970830,
      "link": null,
      "locked": false,
      "text": "function Dog(name, breed) {\n    // Constructor Function\n    this.name = name;\n    this.breed = breed;\n}\n\nconst d1 = new Dog(\"Tommy\", \"Labrador\");\n\nconsole.log(d1);",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function Dog(name, breed) {\n    // Constructor Function\n    this.name = name;\n    this.breed = breed;\n}\n\nconst d1 = new Dog(\"Tommy\", \"Labrador\");\n\nconsole.log(d1);",
      "autoResize": true,
      "lineHeight": 1.25
    },
