    {
      "id": "IsS2x-FLEij674SfFlmTF",
      "type": "text",
      "x": 29910.710451126204,
      "y": 22088.552249395485,
      "width": 1762.4303995768255,
      "height": 473.60567244858794,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
