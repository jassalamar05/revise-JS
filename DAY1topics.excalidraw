    {
      "id": "xQFPrP9cEM7F_Ki_dpIzb",
      "type": "text",
      "x": 45865.26731561149,
      "y": 2369.396008594829,
      "width": 1876.22265625,
      "height": 210,
      "angle": 0,
      "strokeColor": "#be4bdb",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKQ",
