    {
      "id": "hiBmYrHKgdsKrLfhCtGwh",
      "type": "text",
      "x": 19731.946885608493,
      "y": 4346.8867681594165,
      "width": 549.4389189220605,
      "height": 161.42857142857125,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
