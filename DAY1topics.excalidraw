      "containerId": null,
      "originalText": "Sabse pehle this kya karta hai?\n\n👉 this hamesha us object ko point karta hai jisne function ko call kiya hai.\n\nExample: NORMAL FUCNTION KA THIS KAA KAAM",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Q_Y5BUZv-99Xu5gahD6wo",
      "type": "text",
      "x": 29076.4514837719,
      "y": 5653.182400831482,
      "width": 486.5797424316406,
      "height": 575,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBs",
      "roundness": null,
      "seed": 1905114863,
      "version": 6,
      "versionNonce": 657574625,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "sodGhG241zrQyd7Fmj_e4",
          "type": "arrow"
        }
      ],
      "updated": 1784751611621,
      "link": null,
      "locked": false,
      "text": "const person = {\n    name: \"Amar\",\n\n    show: function () {\n\n        console.log(\"1. show() ka this =\", this);\n        // ✅ this = person\n\n        setTimeout(function () {\n\n            console.log(\"2. Callback ka this =\", this);\n            // ❌ this = window (browser)\n            // ❌ this = Timeout object (Node.js)\n\n            console.log(this.name);\n            // ❌ undefined\n\n        }, 1000);\n\n    }\n};\n\nperson.show();",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const person = {\n    name: \"Amar\",\n\n    show: function () {\n\n        console.log(\"1. show() ka this =\", this);\n        // ✅ this = person\n\n        setTimeout(function () {\n\n            console.log(\"2. Callback ka this =\", this);\n            // ❌ this = window (browser)\n            // ❌ this = Timeout object (Node.js)\n\n            console.log(this.name);\n            // ❌ undefined\n\n        }, 1000);\n\n    }\n};\n\nperson.show();",
      "autoResize": true,
      "lineHeight": 1.25
    },
