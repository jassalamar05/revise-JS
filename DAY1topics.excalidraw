    {
      "id": "4qOaqRyB1OqzFShpYJXun",
      "type": "text",
      "x": 35191.268115026,
      "y": 24945.955143314797,
      "width": 1053.633239746091,
      "height": 503.5365220562439,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
