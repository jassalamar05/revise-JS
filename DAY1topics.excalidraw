    {
      "id": "FtLQWo82-CtgM89VlBJ0b",
      "type": "text",
      "x": 25488.844160795885,
      "y": 682.1375125553593,
      "width": 731.4716796875,
      "height": 175,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
