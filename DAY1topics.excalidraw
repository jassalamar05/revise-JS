    {
      "id": "u0npdKFPxSybjo1DLcxnZ",
      "type": "text",
      "x": 13313.508106413348,
      "y": 9914.883408612339,
      "width": 2216.195556640625,
      "height": 315,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
