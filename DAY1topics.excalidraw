    {
      "id": "rHf-rAXrNTo3Ie4TYK8ED",
      "type": "text",
      "x": 25386.528068567437,
      "y": 11866.025616909552,
      "width": 1924.74658203125,
      "height": 420,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
