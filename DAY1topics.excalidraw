      "seed": 131526127,
      "version": 3,
      "versionNonce": 333971521,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784754761448,
      "link": null,
      "locked": false,
      "text": "function hello(num) {\n\n    if (num == 0) {\n        return;\n    }\n\n    console.log(num);\n\n    hello(num - 1);\n\n}\n\nhello(5);",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function hello(num) {\n\n    if (num == 0) {\n        return;\n    }\n\n    console.log(num);\n\n    hello(num - 1);\n\n}\n\nhello(5);",
      "autoResize": true,
      "lineHeight": 1.25
    },
