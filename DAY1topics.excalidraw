      "seed": 949489541,
      "version": 5,
      "versionNonce": 178706891,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785511599614,
      "link": null,
      "locked": false,
      "text": "🟢 Object.freeze()\nTheory\n\nObject.freeze() object ko completely lock kar deta hai.\n\nFreeze ke baad:\n\n❌ New property add nahi kar sakte.\n❌ Existing property delete nahi kar sakte.\n❌ Existing property ki value bhi change nahi kar sakte.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🟢 Object.freeze()\nTheory\n\nObject.freeze() object ko completely lock kar deta hai.\n\nFreeze ke baad:\n\n❌ New property add nahi kar sakte.\n❌ Existing property delete nahi kar sakte.\n❌ Existing property ki value bhi change nahi kar sakte.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "mN5BVs6ipqAvWUnt6vZ0c",
      "type": "text",
      "x": 48467.3093531086,
      "y": 1101.8375909634956,
      "width": 304.807861328125,
      "height": 315,
      "angle": 0,
      "strokeColor": "#ffd43b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bMO",
      "roundness": null,
      "seed": 1624418085,
      "version": 16,
      "versionNonce": 160714885,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785511609979,
      "link": null,
      "locked": false,
      "text": "const user = {\n  name: \"Amar\"\n};\n\nObject.freeze(user);\n\nuser.name = \"Rahul\";\n\nconsole.log(user.name);",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const user = {\n  name: \"Amar\"\n};\n\nObject.freeze(user);\n\nuser.name = \"Rahul\";\n\nconsole.log(user.name);",
      "autoResize": true,
      "lineHeight": 1.25
    },
