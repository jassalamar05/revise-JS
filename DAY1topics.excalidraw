    },
    {
      "id": "nO4XMTVzt-W8cMGpddh_Z",
      "type": "text",
      "x": 45960.489489514235,
      "y": -698.8313378004448,
      "width": 1720.1507568359375,
      "height": 70,
      "angle": 0,
      "strokeColor": "#f783ac",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bK7",
      "roundness": null,
      "seed": 1814323307,
      "version": 153,
      "versionNonce": 888706405,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785497996590,
      "link": null,
      "locked": false,
      "text": "yeh appka top level prototyoe object hota hai ko appka last mei check hot ahai  isme appke sare buiklt in fucntion hote hai . \n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "yeh appka top level prototyoe object hota hai ko appka last mei check hot ahai  isme appke sare buiklt in fucntion hote hai . \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hcYGsdAcyIbX9EmtxTK6K",
      "type": "text",
      "x": 45951.230252860594,
      "y": -580.3128644931531,
      "width": 1820.8668212890625,
      "height": 105,
      "angle": 0,
      "strokeColor": "#f783ac",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bK8",
      "roundness": null,
      "seed": 1480867877,
      "version": 5,
      "versionNonce": 1638998117,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785498020044,
      "link": null,
      "locked": false,
      "text": "Object.prototype JavaScript ka top-level Prototype Object hai. Ye almost har normal object ka last parent hota hai aur iske andar \nJavaScript ke common built-in methods (jaise toString(), hasOwnProperty(), valueOf()) hote hain. Prototype Chain me JavaScript ise \nsabse last me search karti hai, uske baad null aata hai.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Object.prototype JavaScript ka top-level Prototype Object hai. Ye almost har normal object ka last parent hota hai aur iske andar \nJavaScript ke common built-in methods (jaise toString(), hasOwnProperty(), valueOf()) hote hain. Prototype Chain me JavaScript ise \nsabse last me search karti hai, uske baad null aata hai.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lnKGumt9tfcMSK6Cd-Erp",
      "type": "text",
      "x": 46214.19320452075,
      "y": -387.7203015998617,
      "width": 585.25,
      "height": 245,
      "angle": 0,
      "strokeColor": "#f783ac",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bK9",
      "roundness": null,
      "seed": 1385564965,
      "version": 5,
      "versionNonce": 1995186571,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785498028351,
      "link": null,
      "locked": false,
      "text": "Current Object\n      ↓\nStudent.prototype\n      ↓\nObject.prototype   ← Top-Level Prototype\n      ↓\nnull",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Current Object\n      ↓\nStudent.prototype\n      ↓\nObject.prototype   ← Top-Level Prototype\n      ↓\nnull",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HOxo1WbFb_DVKyX48-W3b",
      "type": "text",
      "x": 45994.54608944913,
      "y": -95.88009163892411,
      "width": 959.8115234375,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKA",
      "roundness": null,
      "seed": 372472523,
      "version": 13,
      "versionNonce": 1932667787,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785498043790,
      "link": null,
      "locked": false,
      "text": "Socho JavaScript ne Object.prototype sabse last me hi kyu rakha?\n\nKyuki har normal object JavaScript me ultimately ek object hi hota hai.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Socho JavaScript ne Object.prototype sabse last me hi kyu rakha?\n\nKyuki har normal object JavaScript me ultimately ek object hi hota hai.",
      "autoResize": true,
      "lineHeight": 1.25
    },
