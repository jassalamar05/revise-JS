      "link": null,
      "locked": false,
      "text": "Encapsulation\n      ↓\nClosure (Old Encapsulation/Data Hiding)\n      ↓\nClasses\n      ↓\nPrivate Members (#) → Real Data Hiding\n      ↓\nGetter & Setter → Controlled Access to Private Data",
      "fontSize": 36.01349827239211,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Encapsulation\n      ↓\nClosure (Old Encapsulation/Data Hiding)\n      ↓\nClasses\n      ↓\nPrivate Members (#) → Real Data Hiding\n      ↓\nGetter & Setter → Controlled Access to Private Data",
      "autoResize": true,
      "lineHeight": 1.25
    },
