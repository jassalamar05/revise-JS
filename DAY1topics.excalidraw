    },
    {
      "id": "VreG41JFForhT3HnAqaYL",
      "type": "text",
      "x": 58481.96549014955,
      "y": 1098.3705803065077,
      "width": 2841.0611094640826,
      "height": 516.632080078125,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNt",
      "roundness": null,
      "seed": 1983220107,
      "version": 48,
      "versionNonce": 1887776619,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785605152590,
      "link": null,
      "locked": false,
      "text": "| **Compile-Time**                         | **Runtime**                                                          |\n| ---------------------------------------- | -------------------------------------------------------------------- |\n| Decision **Compiler** leta hai.          | Decision **Runtime (JavaScript Engine)** leta hai.                   |\n| Method call pehle hi decide ho jata hai. | Method call object ke type ke hisaab se runtime par decide hota hai. |\n| Method Overloading se achieve hota hai.  | Method Overriding se achieve hota hai.                               |\n| JavaScript me true support nahi hai.     | JavaScript me fully supported hai.                                   |\n| Less Flexible                            | More Flexible                                                        |\n",
      "fontSize": 51.663208007812514,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "| **Compile-Time**                         | **Runtime**                                                          |\n| ---------------------------------------- | -------------------------------------------------------------------- |\n| Decision **Compiler** leta hai.          | Decision **Runtime (JavaScript Engine)** leta hai.                   |\n| Method call pehle hi decide ho jata hai. | Method call object ke type ke hisaab se runtime par decide hota hai. |\n| Method Overloading se achieve hota hai.  | Method Overriding se achieve hota hai.                               |\n| JavaScript me true support nahi hai.     | JavaScript me fully supported hai.                                   |\n| Less Flexible                            | More Flexible                                                        |\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
