    {
      "id": "4CcBF_D59QYl-Tr_gDOAN",
      "type": "text",
      "x": 663.720342354555,
      "y": 2191.9979694531703,
      "width": 1266.1591796875,
      "height": 1275,
      "angle": 0,
      "strokeColor": "#2f9e44",
