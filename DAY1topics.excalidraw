      "boundElements": [],
      "updated": 1784754812482,
      "link": null,
      "locked": false,
      "text": "Recursion ke 2 Rules ⭐⭐⭐⭐⭐\n1. Base Case\nKab rukna hai?\n2. Recursive Call\nKhud ko dobara call karo.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recursion ke 2 Rules ⭐⭐⭐⭐⭐\n1. Base Case\nKab rukna hai?\n2. Recursive Call\nKhud ko dobara call karo.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "a36qY0qEan8O4K4jR4B4v",
      "type": "text",
      "x": 30511.15860176097,
      "y": 21538.19212048064,
      "width": 892.331787109375,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bD1",
      "roundness": null,
      "seed": 1095189825,
      "version": 24,
      "versionNonce": 172106273,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784754827405,
      "link": null,
      "locked": false,
      "text": "| For Loop            | Recursion                                 |\n| ------------------- | ----------------------------------------- |\n| Loop use karta hai  | Function khud ko call karta hai           |\n| Stack use nahi hoti | Call Stack use hoti hai                   |\n| Fast hota hai       | Thoda slow ho sakta hai                   |\n| Memory kam          | Memory zyada (har call stack me jati hai) |\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "| For Loop            | Recursion                                 |\n| ------------------- | ----------------------------------------- |\n| Loop use karta hai  | Function khud ko call karta hai           |\n| Stack use nahi hoti | Call Stack use hoti hai                   |\n| Fast hota hai       | Thoda slow ho sakta hai                   |\n| Memory kam          | Memory zyada (har call stack me jati hai) |\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
