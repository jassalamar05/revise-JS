    {
      "id": "bvZEB7w6tnUyFsnt9cQJ2",
      "type": "text",
      "x": 30588.213146845606,
      "y": 20688.944443831428,
      "width": 281.00787353515625,
      "height": 455,
      "angle": 0,
      "strokeColor": "#da77f2",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
