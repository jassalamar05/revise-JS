      "seed": 241949167,
      "version": 37,
      "versionNonce": 663611329,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784610756306,
      "link": null,
      "locked": false,
      "text": "Error Handling ka matlab hai program me aane wale errors ko detect aur handle karna taki application unexpectedly crash na ho aur\nuser ko proper error message ya fallback behavior mil sake.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Error Handling ka matlab hai program me aane wale errors ko detect aur handle karna taki application unexpectedly crash na ho aur user ko proper error message ya fallback behavior mil sake.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "slCOlhJ55eFFdGO-fzakn",
      "type": "text",
      "x": 25594.32994845025,
      "y": 8420.979435257257,
      "width": 1142.3714599609375,
      "height": 245,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
