    {
      "id": "noEkhpT5ohQtDlI-fjfii",
      "type": "text",
      "x": 28633.635702506283,
      "y": 1969.9649964129533,
      "width": 1129.7328885200125,
      "height": 77.40158081054689,
      "angle": 0,
