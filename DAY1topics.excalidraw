      "text": "Adding methods to Prototype ::\n\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Adding methods to Prototype ::\n\n",
