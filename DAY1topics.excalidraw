      "boundElements": [],
      "updated": 1785495225860,
      "link": null,
      "locked": false,
      "text": "ab yeh ek complete porototype methid bann gya ahi .\n\njisme appa rela objecrt hota hai a-> isme appka ek method a gya hai \n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ab yeh ek complete porototype methid bann gya ahi .\n\njisme appa rela objecrt hota hai a-> isme appka ek method a gya hai \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vusoTpyaWQBVtlY_zamaV",
      "type": "text",
      "x": 45819.20835675139,
      "y": -5550.909793162062,
      "width": 1468.43896484375,
      "height": 400,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJ6",
      "roundness": null,
      "seed": 810844357,
      "version": 923,
      "versionNonce": 1402161579,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785495515314,
      "link": null,
      "locked": false,
      "text": ">> next you have __ proto__ = jab bhi object create hote hai koibhi uska proto sath mei hi create hota hai ->> \n\nCases ::: case 1: \n\nagar jo obehjct create kiya hai jis fucntion ke sath agar usme woh data mil jata hai direclty toh hamko proto tak jane ki jarurat nai hgaui \n\nCASE 2 ::::\n\nagar data naimila and suppose woh data ka link protoytpe ke sath baan raha hai toh JS directly toh waha se nikal nai sakta toh appka \n\nkaam aaata hai __ proto __ \n\n\nPTOTO -> hidden link hai har obj ka uske parent object ke sath > hidden link se hi woh seacrghing karta hgai jisko app prototype chaining  kehte ho .\n\nyeh kuch nai hai bass link provide krega appke parent fucntion ke sath taaki uss mei se woh method ya property nikal sake ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": ">> next you have __ proto__ = jab bhi object create hote hai koibhi uska proto sath mei hi create hota hai ->> \n\nCases ::: case 1: \n\nagar jo obehjct create kiya hai jis fucntion ke sath agar usme woh data mil jata hai direclty toh hamko proto tak jane ki jarurat nai hgaui \n\nCASE 2 ::::\n\nagar data naimila and suppose woh data ka link protoytpe ke sath baan raha hai toh JS directly toh waha se nikal nai sakta toh appka \n\nkaam aaata hai __ proto __ \n\n\nPTOTO -> hidden link hai har obj ka uske parent object ke sath > hidden link se hi woh seacrghing karta hgai jisko app prototype chaining  kehte ho .\n\nyeh kuch nai hai bass link provide krega appke parent fucntion ke sath taaki uss mei se woh method ya property nikal sake ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Bcd2oaf-bX1ua-UCjsN02",
      "type": "text",
      "x": 45775.79424084563,
      "y": -5118.7410803952425,
      "width": 935.219482421875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
