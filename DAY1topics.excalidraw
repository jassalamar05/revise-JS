    {
      "id": "PETz8uHpl_P2qt_l8NPKD",
      "type": "text",
      "x": 35618.089184,
      "y": 15874.454213791405,
      "width": 589.1478271484375,
      "height": 595,
      "angle": 0,
      "strokeColor": "#4dabf7",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
