      "updated": 1784755410831,
      "link": null,
      "locked": false,
      "text": "next()\n\nnext() Generator Function ko agle yield tak chalata h",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "next()\n\nnext() Generator Function ko agle yield tak chalata h",
      "autoResize": true,
