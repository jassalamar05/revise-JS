      "boundElements": [],
      "updated": 1785498148172,
      "link": null,
      "locked": false,
      "text": "iskiliye ek common Parent top level obnejct banaya gya jisme inbuilt fucntion add kiye gye the .\n\n\n\nObject.prototype\n\n{\n   toString()\n   hasOwnProperty()\n   valueOf()\n}",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "iskiliye ek common Parent top level obnejct banaya gya jisme inbuilt fucntion add kiye gye the .\n\n\n\nObject.prototype\n\n{\n   toString()\n   hasOwnProperty()\n   valueOf()\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
