    {
      "id": "upCGfUL-hN1dHWSk7duu0",
      "type": "text",
      "x": 34188.62617492676,
      "y": -3479.045734379028,
      "width": 651.81640625,
      "height": 3650,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGm",
      "roundness": null,
      "seed": 1025649078,
      "version": 196,
      "versionNonce": 1301923818,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785153723457,
      "link": null,
      "locked": false,
      "text": "                         START\n                           │\n                           ▼\n┌────────────────────────────────────────────┐\n│ 1. Machine Language (1940s)                │\n│                                            │\n│ Computer sirf 0 aur 1 samajhta tha.        │\n│                                            │\n│ Example:                                   │\n│ 10101010                                  │\n│                                            │\n│ ✅ Directly CPU execute karta tha          │\n│                                            │\n│ ❌ Problems                                │\n│ • Human ke liye impossible                 │\n│ • Bahut errors                             │\n│ • Bahut slow development                   │\n└────────────────────────────────────────────┘\n                    │\n                    │ Scientists bole:\n                    │ \"Readable bana dete hain.\"\n                    ▼\n┌────────────────────────────────────────────┐\n│ 2. Assembly Language (1950s)               │\n│                                            │\n│ Binary ki jagah mnemonics                  │\n│                                            │\n│ Example                                   │\n│ MOV A,B                                   │\n│ ADD A,C                                   │\n│                                            │\n│ Assembler → Machine Code                  │\n│                                            │\n│ ✅ 0 aur 1 yaad nahi rakhni padti          │\n│                                            │\n│ ❌ Problems                                │\n│ • Hardware dependent                       │\n│ • Har CPU ki alag Assembly                 │\n│ • Fir bhi difficult                        │\n└────────────────────────────────────────────┘\n                    │\n                    │ Scientists bole:\n                    │ \"English jaisi language bana dete hain.\"\n                    ▼\n┌────────────────────────────────────────────┐\n│ 3. High-Level Language (1960s)             │\n│                                            │\n│ Example                                   │\n│ int a = 10;                               │\n│ printf(\"%d\",a);                           │\n│                                            │\n│ Compiler → Machine Code                   │\n│                                            │\n│ ✅ Easy syntax                             │\n│ ✅ Fast development                        │\n│ ✅ Human readable                          │\n│                                            │\n│ ❌ Problems                                │\n│ Software bahut bade hone lage             │\n│                                            │\n│ 50,000+ lines                             │\n│ Maintain karna difficult                  │\n└────────────────────────────────────────────┘\n                    │\n                    │ Scientists bole:\n                    │ \"Code ko functions mein tod dete hain.\"\n                    ▼\n┌────────────────────────────────────────────┐\n│ 4. Procedural Programming (POP)            │\n│                                            │\n│ Focus = Functions                          │\n│                                            │\n│ deposit()                                 │\n│ withdraw()                                │\n│ transfer()                                │\n│                                            │\n│ ✅ Code organized                          │\n│ ✅ Chhote projects easy                    │\n│                                            │\n│ ❌ Problems                                │\n│                                            │\n│ 1. Data insecure                           │\n│    Har function data change kar sakta      │\n│                                            │\n│ 2. Code duplication                        │\n│                                            │\n│ 3. Difficult maintenance                   │\n│                                            │\n│ 4. Real-world modeling weak                │\n└────────────────────────────────────────────┘\n                    │\n                    │ Scientists bole:\n                    │ \"Data aur functions ko\n                    │ ek hi jagah rakhte hain.\"\n                    ▼\n┌────────────────────────────────────────────┐\n│ 5. Object-Based Programming (OBP)          │\n│                                            │\n│ Focus = Objects                            │\n│                                            │\n│ student={                                  │\n│  name, age, study()                        │\n│ }                                          │\n│                                            │\n│ ✅ Data + Methods together                 │\n│ ✅ Better organization                     │\n│                                            │\n│ ❌ Problems                                │\n│                                            │\n│ No Classes                                │\n│ No Inheritance                            │\n│ No Polymorphism                           │\n│ Reuse limited                             │\n└────────────────────────────────────────────┘\n                    │\n                    │ Scientists bole:\n                    │ \"Blueprint bana dete hain.\"\n                    ▼\n┌────────────────────────────────────────────┐\n│ 6. Object-Oriented Programming (OOP)       │\n│                                            │\n│ Focus = Classes + Objects                  │\n│                                            │\n│ class Student {}                           │\n│                                            │\n│ new Student()                              │\n│                                            │\n│ ✅ Encapsulation                           │\n│ Data secure                               │\n│                                            │\n│ ✅ Inheritance                             │\n│ Code reuse                                │\n│                                            │\n│ ✅ Polymorphism                            │\n│ Same interface, different behavior         │\n│                                            │\n│ ✅ Abstraction                             │\n│ Sirf important details expose              │\n│                                            │\n│ Result                                     │\n│ Secure                                    │\n│ Reusable                                  │\n│ Maintainable                              │\n│ Scalable                                  │\n│ Real-world modeling                       │\n└────────────────────────────────────────────┘",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "                         START\n                           │\n                           ▼\n┌────────────────────────────────────────────┐\n│ 1. Machine Language (1940s)                │\n│                                            │\n│ Computer sirf 0 aur 1 samajhta tha.        │\n│                                            │\n│ Example:                                   │\n│ 10101010                                  │\n│                                            │\n│ ✅ Directly CPU execute karta tha          │\n│                                            │\n│ ❌ Problems                                │\n│ • Human ke liye impossible                 │\n│ • Bahut errors                             │\n│ • Bahut slow development                   │\n└────────────────────────────────────────────┘\n                    │\n                    │ Scientists bole:\n                    │ \"Readable bana dete hain.\"\n                    ▼\n┌────────────────────────────────────────────┐\n│ 2. Assembly Language (1950s)               │\n│                                            │\n│ Binary ki jagah mnemonics                  │\n│                                            │\n│ Example                                   │\n│ MOV A,B                                   │\n│ ADD A,C                                   │\n│                                            │\n│ Assembler → Machine Code                  │\n│                                            │\n│ ✅ 0 aur 1 yaad nahi rakhni padti          │\n│                                            │\n│ ❌ Problems                                │\n│ • Hardware dependent                       │\n│ • Har CPU ki alag Assembly                 │\n│ • Fir bhi difficult                        │\n└────────────────────────────────────────────┘\n                    │\n                    │ Scientists bole:\n                    │ \"English jaisi language bana dete hain.\"\n                    ▼\n┌────────────────────────────────────────────┐\n│ 3. High-Level Language (1960s)             │\n│                                            │\n│ Example                                   │\n│ int a = 10;                               │\n│ printf(\"%d\",a);                           │\n│                                            │\n│ Compiler → Machine Code                   │\n│                                            │\n│ ✅ Easy syntax                             │\n│ ✅ Fast development                        │\n│ ✅ Human readable                          │\n│                                            │\n│ ❌ Problems                                │\n│ Software bahut bade hone lage             │\n│                                            │\n│ 50,000+ lines                             │\n│ Maintain karna difficult                  │\n└────────────────────────────────────────────┘\n                    │\n                    │ Scientists bole:\n                    │ \"Code ko functions mein tod dete hain.\"\n                    ▼\n┌────────────────────────────────────────────┐\n│ 4. Procedural Programming (POP)            │\n│                                            │\n│ Focus = Functions                          │\n│                                            │\n│ deposit()                                 │\n│ withdraw()                                │\n│ transfer()                                │\n│                                            │\n│ ✅ Code organized                          │\n│ ✅ Chhote projects easy                    │\n│                                            │\n│ ❌ Problems                                │\n│                                            │\n│ 1. Data insecure                           │\n│    Har function data change kar sakta      │\n│                                            │\n│ 2. Code duplication                        │\n│                                            │\n│ 3. Difficult maintenance                   │\n│                                            │\n│ 4. Real-world modeling weak                │\n└────────────────────────────────────────────┘\n                    │\n                    │ Scientists bole:\n                    │ \"Data aur functions ko\n                    │ ek hi jagah rakhte hain.\"\n                    ▼\n┌────────────────────────────────────────────┐\n│ 5. Object-Based Programming (OBP)          │\n│                                            │\n│ Focus = Objects                            │\n│                                            │\n│ student={                                  │\n│  name, age, study()                        │\n│ }                                          │\n│                                            │\n│ ✅ Data + Methods together                 │\n│ ✅ Better organization                     │\n│                                            │\n│ ❌ Problems                                │\n│                                            │\n│ No Classes                                │\n│ No Inheritance                            │\n│ No Polymorphism                           │\n│ Reuse limited                             │\n└────────────────────────────────────────────┘\n                    │\n                    │ Scientists bole:\n                    │ \"Blueprint bana dete hain.\"\n                    ▼\n┌────────────────────────────────────────────┐\n│ 6. Object-Oriented Programming (OOP)       │\n│                                            │\n│ Focus = Classes + Objects                  │\n│                                            │\n│ class Student {}                           │\n│                                            │\n│ new Student()                              │\n│                                            │\n│ ✅ Encapsulation                           │\n│ Data secure                               │\n│                                            │\n│ ✅ Inheritance                             │\n│ Code reuse                                │\n│                                            │\n│ ✅ Polymorphism                            │\n│ Same interface, different behavior         │\n│                                            │\n│ ✅ Abstraction                             │\n│ Sirf important details expose              │\n│                                            │\n│ Result                                     │\n│ Secure                                    │\n│ Reusable                                  │\n│ Maintainable                              │\n│ Scalable                                  │\n│ Real-world modeling                       │\n└────────────────────────────────────────────┘",
      "autoResize": true,
      "lineHeight": 1.25
