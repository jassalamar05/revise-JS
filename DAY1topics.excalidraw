    {
      "id": "5WWPbgIG1DqF2TZporRQg",
      "type": "text",
      "x": 48409.583828206254,
      "y": 642.9838311978706,
      "width": 765.0450439453125,
      "height": 350,
      "angle": 0,
      "strokeColor": "#ffd43b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
