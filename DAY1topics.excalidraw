      "isDeleted": false,
      "boundElements": [
        {
          "id": "3TQJZKLBg-J4GV2VN5huY",
          "type": "arrow"
        }
      ],
      "updated": 1784512894240,
      "link": null,
      "locked": false,
      "text": "function step1(callback) {\n    console.log(\"Step 1\");\n    callback();\n}\n\nfunction step2(callback) {\n    console.log(\"Step 2\");\n    callback();\n}\n\nfunction step3(callback) {\n    console.log(\"Step 3\");\n    callback();\n}\n\nfunction step4(callback) {\n    console.log(\"Step 4\");\n    callback();\n}\n\n// Callback Hell\n\nstep1(function () {\n\n    step2(function () {\n\n        step3(function () {\n\n            step4(function () {\n\n                console.log(\"All Steps Completed\");\n\n            });\n\n        });\n\n    });\n\n});",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function step1(callback) {\n    console.log(\"Step 1\");\n    callback();\n}\n\nfunction step2(callback) {\n    console.log(\"Step 2\");\n    callback();\n}\n\nfunction step3(callback) {\n    console.log(\"Step 3\");\n    callback();\n}\n\nfunction step4(callback) {\n    console.log(\"Step 4\");\n    callback();\n}\n\n// Callback Hell\n\nstep1(function () {\n\n    step2(function () {\n\n        step3(function () {\n\n            step4(function () {\n\n                console.log(\"All Steps Completed\");\n\n            });\n\n        });\n\n    });\n\n});",
      "autoResize": true,
      "lineHeight": 1.25
    },
