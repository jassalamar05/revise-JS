    {
      "id": "n4MGiu-EED5_DoY546IDx",
      "type": "text",
      "x": 5573.199810858987,
      "y": 1906.0596984798074,
      "width": 1482.59912109375,
      "height": 1155,
      "angle": 0,
      "strokeColor": "#e64980",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
