      "link": null,
      "locked": false,
      "text": "Why Arrow Function was Introduced?\nBefore ES6\n\nProblems:\n\nLong syntax\nthis keyword problem\nCallback functions were lengthy",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why Arrow Function was Introduced?\nBefore ES6\n\nProblems:\n\nLong syntax\nthis keyword problem\nCallback functions were lengthy",
      "autoResize": true,
      "lineHeight": 1.25
    },
