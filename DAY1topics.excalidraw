    {
      "id": "XPnVDSrbogdrbgJrRe_nF",
      "type": "text",
      "x": 6391.315572484145,
      "y": 3189.010646665924,
      "width": 507.3038024902344,
      "height": 2660,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1z",
      "roundness": null,
      "seed": 406604916,
      "version": 4,
      "versionNonce": 181667916,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783254809751,
      "link": null,
      "locked": false,
      "text": "// Program Start\n\n// ----------------------------\n// CALL STACK\n// ----------------------------\n// | Global EC |\n// ----------------------------\n\nfunction first() {\n\n    // first() call hua\n\n    // ----------------------------\n    // CALL STACK\n    // ----------------------------\n    // | first EC  |   <- Top (Active)\n    // | Global EC |\n    // ----------------------------\n\n    console.log(\"Inside First\");\n\n    second();\n\n    // second() khatam hone ke baad\n    // execution yahi wapas aayega\n\n    console.log(\"First End\");\n}\n\nfunction second() {\n\n    // second() call hua\n\n    // ----------------------------\n    // CALL STACK\n    // ----------------------------\n    // | second EC |   <- Top (Active)\n    // | first EC  |\n    // | Global EC |\n    // ----------------------------\n\n    console.log(\"Inside Second\");\n\n    // Function End\n\n    // second EC destroy hoga\n\n    // ----------------------------\n    // CALL STACK\n    // ----------------------------\n    // | first EC  |   <- Active\n    // | Global EC |\n    // ----------------------------\n}\n\nconsole.log(\"Program Start\");\n\nfirst();\n\nconsole.log(\"Program End\");\n\n// first() bhi complete\n\n// ----------------------------\n// CALL STACK\n// ----------------------------\n// | Global EC |\n// ----------------------------\n\n// Global code bhi complete\n\n// ----------------------------\n// CALL STACK\n// ----------------------------\n// Empty\n// ----------------------------",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Program Start\n\n// ----------------------------\n// CALL STACK\n// ----------------------------\n// | Global EC |\n// ----------------------------\n\nfunction first() {\n\n    // first() call hua\n\n    // ----------------------------\n    // CALL STACK\n    // ----------------------------\n    // | first EC  |   <- Top (Active)\n    // | Global EC |\n    // ----------------------------\n\n    console.log(\"Inside First\");\n\n    second();\n\n    // second() khatam hone ke baad\n    // execution yahi wapas aayega\n\n    console.log(\"First End\");\n}\n\nfunction second() {\n\n    // second() call hua\n\n    // ----------------------------\n    // CALL STACK\n    // ----------------------------\n    // | second EC |   <- Top (Active)\n    // | first EC  |\n    // | Global EC |\n    // ----------------------------\n\n    console.log(\"Inside Second\");\n\n    // Function End\n\n    // second EC destroy hoga\n\n    // ----------------------------\n    // CALL STACK\n    // ----------------------------\n    // | first EC  |   <- Active\n    // | Global EC |\n    // ----------------------------\n}\n\nconsole.log(\"Program Start\");\n\nfirst();\n\nconsole.log(\"Program End\");\n\n// first() bhi complete\n\n// ----------------------------\n// CALL STACK\n// ----------------------------\n// | Global EC |\n// ----------------------------\n\n// Global code bhi complete\n\n// ----------------------------\n// CALL STACK\n// ----------------------------\n// Empty\n// ----------------------------",
      "autoResize": true,
      "lineHeight": 1.25
    },
