      "boundElements": [],
      "updated": 1785496535613,
      "link": null,
      "locked": false,
      "text": "prototype ek property hoti hai Constructor Function ya Class ki. \nYe Prototype Object ka reference hold karti hai. Prototype Object ke andar by\n default constructor property hoti hai aur hum usme shared methods add kar sakte hain. ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "prototype ek property hoti hai Constructor Function ya Class ki. \nYe Prototype Object ka reference hold karti hai. Prototype Object ke andar by\n default constructor property hoti hai aur hum usme shared methods add kar sakte hain. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pqiNg-dEEj2ElMnTwdrxx",
      "type": "text",
      "x": 46103.230902474104,
      "y": -4586.8479096340825,
      "width": 586.9300537109375,
      "height": 420,
      "angle": 0,
      "strokeColor": "#4dabf7",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
