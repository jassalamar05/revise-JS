      "updated": 1783258232763,
      "link": null,
      "locked": false,
      "text": "function introduce(city) {\n    console.log(\n        \"Name:\", this.name,\n        \"| Age:\", this.age,\n        \"| City:\", city\n    );\n}\n\nconst user1 = {\n    name: \"Amardeep\",\n    age: 24\n};\n\nconst user2 = {\n    name: \"Rahul\",\n    age: 26\n};\n\nintroduce.call(user1, \"Delhi\");\nintroduce.call(user2, \"Mumbai\");",
      "fontSize": 36.59297699031784,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function introduce(city) {\n    console.log(\n        \"Name:\", this.name,\n        \"| Age:\", this.age,\n        \"| City:\", city\n    );\n}\n\nconst user1 = {\n    name: \"Amardeep\",\n    age: 24\n};\n\nconst user2 = {\n    name: \"Rahul\",\n    age: 26\n};\n\nintroduce.call(user1, \"Delhi\");\nintroduce.call(user2, \"Mumbai\");",
      "autoResize": true,
      "lineHeight": 1.25
    },
