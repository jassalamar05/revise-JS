    },
    {
      "id": "8B32oRqnVtm5o4TwaSQm6",
      "type": "text",
      "x": 47588.43302123431,
      "y": -4741.9379631299325,
      "width": 615.8877563476562,
      "height": 105,
      "angle": 0,
      "strokeColor": "#ffa94d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bLl",
      "roundness": null,
      "seed": 1568408107,
      "version": 14,
      "versionNonce": 1530246539,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785506043872,
      "link": null,
      "locked": false,
      "text": "Why Adding Methods to Prototype?\n\nAgar methods constructor ke andar banaoge:",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why Adding Methods to Prototype?\n\nAgar methods constructor ke andar banaoge:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ljxsNX9Is8vbDXLS8CVdw",
      "type": "text",
      "x": 47599.11008422259,
      "y": -4569.264318110401,
      "width": 634.8436279296875,
      "height": 350,
      "angle": 0,
      "strokeColor": "#ffa94d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bLm",
      "roundness": null,
      "seed": 1009258187,
      "version": 3,
      "versionNonce": 1270907429,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785506050760,
      "link": null,
      "locked": false,
      "text": "function Student(name) {\n    this.name = name;\n\n    this.study = function () {\n        console.log(`${this.name} is studying`);\n    };\n}\n\nconst s1 = new Student(\"Amar\");\nconst s2 = new Student(\"Rahul\");",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function Student(name) {\n    this.name = name;\n\n    this.study = function () {\n        console.log(`${this.name} is studying`);\n    };\n}\n\nconst s1 = new Student(\"Amar\");\nconst s2 = new Student(\"Rahul\");",
      "autoResize": true,
      "lineHeight": 1.25
    },
