      "seed": 1544540581,
      "version": 223,
      "versionNonce": 1834276773,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785498645815,
      "link": null,
      "locked": false,
      "text": "jo ajj opps inhertiace hoti hai woh appko protype based hoti hai ajj kal toh ham siraf extends use krke super() use krek kam kar lete hai\n\nbehind the scene kasie working hoti hai kya appko pta hai ????\n\n\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "jo ajj opps inhertiace hoti hai woh appko protype based hoti hai ajj kal toh ham siraf extends use krke super() use krek kam kar lete hai\n\nbehind the scene kasie working hoti hai kya appko pta hai ????\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Ybd9HQj_61rmhXPpwolVx",
      "type": "text",
      "x": 45861.56360060498,
      "y": 2588.840385222433,
      "width": 2070.1874745686873,
      "height": 140,
      "angle": 0,
      "strokeColor": "#be4bdb",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKR",
      "roundness": null,
      "seed": 843026923,
      "version": 482,
      "versionNonce": 2016096267,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785498915529,
      "link": null,
      "locked": false,
      "text": "Inheritance ka matlab hai ki child class automatically parent class ki properties aur methods ko access kar sakti hai. Isse code reusability hoti hai aur\nparent-child relationship maintain rehta hai. Jab child ka object banta hai, to child apne members ke saath parent ke members bhi use kar sakti hai. Isi\nliye agar child ke constructor ya methods ke andar parent ki properties ya methods ki zarurat ho, to woh easily access ki ja sakti hain (JavaScript\nmein super() ke through parent constructor ko call kiya jata hai).",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Inheritance ka matlab hai ki child class automatically parent class ki properties aur methods ko access kar sakti hai. Isse code reusability hoti hai aur parent-child relationship maintain rehta hai. Jab child ka object banta hai, to child apne members ke saath parent ke members bhi use kar sakti hai. Isi liye agar child ke constructor ya methods ke andar parent ki properties ya methods ki zarurat ho, to woh easily access ki ja sakti hain (JavaScript mein super() ke through parent constructor ko call kiya jata hai).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "gBnEOmgdQlyekULJ-kPec",
      "type": "text",
      "x": 46034.723034605624,
      "y": 2868.7884000675162,
      "width": 1094.547607421875,
      "height": 35,
      "angle": 0,
      "strokeColor": "#be4bdb",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKS",
      "roundness": null,
      "seed": 809645323,
      "version": 3,
      "versionNonce": 541487077,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785498931032,
      "link": null,
      "locked": false,
      "text": "Inheritance = Parent ki functionality ko Child mein reuse karna, bina dubara likhe",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Inheritance = Parent ki functionality ko Child mein reuse karna, bina dubara likhe",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wPY-HXcoCBKJ7dcuGfKeE",
      "type": "text",
      "x": 46391.001924579585,
      "y": 2971.7396426821933,
      "width": 856.127685546875,
      "height": 10430,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKU",
      "roundness": null,
      "seed": 1875886667,
      "version": 11,
      "versionNonce": 1815677387,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785499068043,
      "link": null,
      "locked": false,
      "text": "// ==========================\n// Parent Constructor\n// ==========================\n\nfunction Animal(name) {\n    this.name = name; // Object me 'name' property add hogi.\n}\n\n// Animal.prototype me shared method add kiya.\nAnimal.prototype.eat = function () {\n    console.log(this.name + \" is eating\");\n};\n\n\n// ==========================\n// Child Constructor\n// ==========================\n\nfunction Dog(name, breed) {\n\n    // Animal constructor ko Dog ke object par chalao.\n    // Isse 'name' property Dog object me aa jayegi.\n    Animal.call(this, name);\n\n    // Dog ki apni property\n    this.breed = breed;\n}\n\n\n// ==========================\n// By Default\n// ==========================\n\n// Jab Dog function bana tha tab JavaScript ne automatically:\n\n// Dog.prototype = {\n//      constructor: Dog\n// }\n\n// banaya tha.\n\n\n// ==========================\n// Prototype Inheritance\n// ==========================\n\nDog.prototype = Object.create(Animal.prototype);\n\n/*\nObject.create(Animal.prototype)\n\nEk naya empty object banata hai.\n\nUs naye object ka __proto__\nAnimal.prototype ko point karta hai.\n\nNew Object\n\n{\n\n}\n\n↓\n\n__proto__\n\n↓\n\nAnimal.prototype\n\n\nAb Dog.prototype is naye object ko point karega.\n\nDog.prototype\n\n↓\n\nNew Object\n\n↓\n\nAnimal.prototype\n\n\nProblem:\n\nPurana Dog.prototype replace ho gaya.\n\nPurane Dog.prototype me\n\n{\n   constructor: Dog\n}\n\ntha.\n\nAb naya object hai.\n\nUske andar constructor nahi hai.\n*/\n\n\n// ==========================\n// Constructor Problem\n// ==========================\n\n// Agar ab check kare\n\n// d1.constructor\n\n// Search hogi:\n\n// d1\n// ↓\n// Dog.prototype\n// ↓\n// constructor ?\n// ❌ Nahi mila\n\n// ↓\n// Animal.prototype\n// ↓\n// constructor\n// ✅ Animal mil gaya\n\n// Output:\n\n// Animal\n\n// Lekin object Dog ka hai.\n// Isliye ye galat reference hai.\n\n\n// ==========================\n// Constructor Restore\n// ==========================\n\nDog.prototype.constructor = Dog;\n\n/*\n\nAb Dog.prototype ban gaya\n\n{\n\n   constructor: Dog\n\n}\n\n↓\n\n__proto__\n\n↓\n\nAnimal.prototype\n\n\nAb\n\nd1.constructor\n\n↓\n\nDog.prototype\n\n↓\n\nconstructor\n\n↓\n\nDog\n\n✅ Correct\n*/\n\n\n// ==========================\n// Dog ka apna method\n// ==========================\n\nDog.prototype.bark = function () {\n    console.log(this.name + \" is barking\");\n};\n\n\n// ==========================\n// Object Create\n// ==========================\n\nconst d1 = new Dog(\"Tommy\", \"Labrador\");\n\n/*\n\nnew Dog()\n\nStep 1\n\nEmpty Object\n\n{\n\n}\n\nStep 2\n\nd1.__proto__\n\n↓\n\nDog.prototype\n\nStep 3\n\nDog constructor chalega\n\nAnimal.call(this)\n\n↓\n\nname = Tommy\n\nbreed = Labrador\n\nStep 4\n\nObject return\n\n*/\n\n\n// ==========================\n// Method Search\n// ==========================\n\nd1.bark();\n\n/*\n\nd1\n\n↓\n\nbark ?\n\n❌\n\n↓\n\nDog.prototype\n\n↓\n\nbark ?\n\n✅\n\nExecute\n\n*/\n\n\nd1.eat();\n\n/*\n\nd1\n\n↓\n\neat ?\n\n❌\n\n↓\n\nDog.prototype\n\n↓\n\neat ?\n\n❌\n\n↓\n\nAnimal.prototype\n\n↓\n\neat ?\n\n✅\n\nExecute\n\n*/",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// ==========================\n// Parent Constructor\n// ==========================\n\nfunction Animal(name) {\n    this.name = name; // Object me 'name' property add hogi.\n}\n\n// Animal.prototype me shared method add kiya.\nAnimal.prototype.eat = function () {\n    console.log(this.name + \" is eating\");\n};\n\n\n// ==========================\n// Child Constructor\n// ==========================\n\nfunction Dog(name, breed) {\n\n    // Animal constructor ko Dog ke object par chalao.\n    // Isse 'name' property Dog object me aa jayegi.\n    Animal.call(this, name);\n\n    // Dog ki apni property\n    this.breed = breed;\n}\n\n\n// ==========================\n// By Default\n// ==========================\n\n// Jab Dog function bana tha tab JavaScript ne automatically:\n\n// Dog.prototype = {\n//      constructor: Dog\n// }\n\n// banaya tha.\n\n\n// ==========================\n// Prototype Inheritance\n// ==========================\n\nDog.prototype = Object.create(Animal.prototype);\n\n/*\nObject.create(Animal.prototype)\n\nEk naya empty object banata hai.\n\nUs naye object ka __proto__\nAnimal.prototype ko point karta hai.\n\nNew Object\n\n{\n\n}\n\n↓\n\n__proto__\n\n↓\n\nAnimal.prototype\n\n\nAb Dog.prototype is naye object ko point karega.\n\nDog.prototype\n\n↓\n\nNew Object\n\n↓\n\nAnimal.prototype\n\n\nProblem:\n\nPurana Dog.prototype replace ho gaya.\n\nPurane Dog.prototype me\n\n{\n   constructor: Dog\n}\n\ntha.\n\nAb naya object hai.\n\nUske andar constructor nahi hai.\n*/\n\n\n// ==========================\n// Constructor Problem\n// ==========================\n\n// Agar ab check kare\n\n// d1.constructor\n\n// Search hogi:\n\n// d1\n// ↓\n// Dog.prototype\n// ↓\n// constructor ?\n// ❌ Nahi mila\n\n// ↓\n// Animal.prototype\n// ↓\n// constructor\n// ✅ Animal mil gaya\n\n// Output:\n\n// Animal\n\n// Lekin object Dog ka hai.\n// Isliye ye galat reference hai.\n\n\n// ==========================\n// Constructor Restore\n// ==========================\n\nDog.prototype.constructor = Dog;\n\n/*\n\nAb Dog.prototype ban gaya\n\n{\n\n   constructor: Dog\n\n}\n\n↓\n\n__proto__\n\n↓\n\nAnimal.prototype\n\n\nAb\n\nd1.constructor\n\n↓\n\nDog.prototype\n\n↓\n\nconstructor\n\n↓\n\nDog\n\n✅ Correct\n*/\n\n\n// ==========================\n// Dog ka apna method\n// ==========================\n\nDog.prototype.bark = function () {\n    console.log(this.name + \" is barking\");\n};\n\n\n// ==========================\n// Object Create\n// ==========================\n\nconst d1 = new Dog(\"Tommy\", \"Labrador\");\n\n/*\n\nnew Dog()\n\nStep 1\n\nEmpty Object\n\n{\n\n}\n\nStep 2\n\nd1.__proto__\n\n↓\n\nDog.prototype\n\nStep 3\n\nDog constructor chalega\n\nAnimal.call(this)\n\n↓\n\nname = Tommy\n\nbreed = Labrador\n\nStep 4\n\nObject return\n\n*/\n\n\n// ==========================\n// Method Search\n// ==========================\n\nd1.bark();\n\n/*\n\nd1\n\n↓\n\nbark ?\n\n❌\n\n↓\n\nDog.prototype\n\n↓\n\nbark ?\n\n✅\n\nExecute\n\n*/\n\n\nd1.eat();\n\n/*\n\nd1\n\n↓\n\neat ?\n\n❌\n\n↓\n\nDog.prototype\n\n↓\n\neat ?\n\n❌\n\n↓\n\nAnimal.prototype\n\n↓\n\neat ?\n\n✅\n\nExecute\n\n*/",
      "autoResize": true,
      "lineHeight": 1.25
    },
