      "boundElements": [],
      "updated": 1785030465789,
      "link": null,
      "locked": false,
      "text": "Sabse pehle Event hota kya hai?\n\nSocho tumne HTML me button banaya.\n\n<button>Login</button>\n\nAbhi ye sirf ek button hai.\n\nIsme koi jaan (behavior) nahi hai.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sabse pehle Event hota kya hai?\n\nSocho tumne HTML me button banaya.\n\n<button>Login</button>\n\nAbhi ye sirf ek button hai.\n\nIsme koi jaan (behavior) nahi hai.",
      "autoResize": true,
      "lineHeight": 1.25
