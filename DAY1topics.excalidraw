      "seed": 579155631,
      "version": 30,
      "versionNonce": 1284225711,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784608519489,
      "link": null,
      "locked": false,
      "text": "Isliye async ke do main kaam ban gaye:\nJavaScript ko batana: \"Ye asynchronous function hai.\"\nAutomatically Promise return karwana.\n\nUske baad hi await safely use kiya ja sakta hai.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Isliye async ke do main kaam ban gaye:\nJavaScript ko batana: \"Ye asynchronous function hai.\"\nAutomatically Promise return karwana.\n\nUske baad hi await safely use kiya ja sakta hai.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VS_rajsZyZJ-RYYBqKzsQ",
      "type": "text",
      "x": 25831.89958071776,
      "y": 932.137436261414,
      "width": 448.76953125,
      "height": 280,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAE",
      "roundness": null,
      "seed": 151971087,
      "version": 35,
      "versionNonce": 1565223311,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784608814422,
      "link": null,
      "locked": false,
      "text": "Normal Function\n        │\n        │ (async lagaya)\n        ▼\nAsync Function\n        │\n        ├── Promise return karegi\n        └── await use karne degi",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Normal Function\n        │\n        │ (async lagaya)\n        ▼\nAsync Function\n        │\n        ├── Promise return karegi\n        └── await use karne degi",
      "autoResize": true,
      "lineHeight": 1.25
    },
