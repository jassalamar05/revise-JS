    {
      "id": "8YYr07jgNo1WpfPd7LZ2i",
      "type": "text",
      "x": 25675.970287347955,
      "y": 7322.628732920713,
      "width": 500.3038330078125,
      "height": 560,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAc",
      "roundness": null,
      "seed": 1751130159,
      "version": 18,
      "versionNonce": 1012052929,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784610689675,
      "link": null,
      "locked": false,
      "text": "function task(name, time) {\n    return new Promise((resolve) => {\n        setTimeout(() => {\n            console.log(name);\n            resolve();\n        }, time);\n    });\n}\n\nasync function main() {\n    await task(\"Task 1\", 1000);\n    await task(\"Task 2\", 1000);\n    await task(\"Task 3\", 1000);\n}\n\nmain();",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function task(name, time) {\n    return new Promise((resolve) => {\n        setTimeout(() => {\n            console.log(name);\n            resolve();\n        }, time);\n    });\n}\n\nasync function main() {\n    await task(\"Task 1\", 1000);\n    await task(\"Task 2\", 1000);\n    await task(\"Task 3\", 1000);\n}\n\nmain();",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Co2_PeIA88bHIdtc0fSDH",
      "type": "text",
      "x": 26685.692729974908,
      "y": 7354.573157750815,
      "width": 500.3038330078125,
      "height": 630,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAd",
      "roundness": null,
      "seed": 1895726351,
      "version": 6,
      "versionNonce": 856658927,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784610701176,
      "link": null,
      "locked": false,
      "text": "function task(name, time) {\n    return new Promise((resolve) => {\n        setTimeout(() => {\n            console.log(name);\n            resolve();\n        }, time);\n    });\n}\n\nasync function main() {\n    await Promise.all([\n        task(\"Task 1\", 1000),\n        task(\"Task 2\", 1000),\n        task(\"Task 3\", 1000)\n    ]);\n}\n\nmain();",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function task(name, time) {\n    return new Promise((resolve) => {\n        setTimeout(() => {\n            console.log(name);\n            resolve();\n        }, time);\n    });\n}\n\nasync function main() {\n    await Promise.all([\n        task(\"Task 1\", 1000),\n        task(\"Task 2\", 1000),\n        task(\"Task 3\", 1000)\n    ]);\n}\n\nmain();",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "d9JCwS1sETrOuR97vPhom",
      "type": "text",
      "x": 25543.483390539062,
      "y": 8188.470716013871,
      "width": 1840.784912109375,
      "height": 70,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAe",
