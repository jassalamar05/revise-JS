    {
      "id": "mNTcUfc70QRisN-IxakWx",
      "type": "text",
      "x": 12261.376209550537,
      "y": 31146.95949189301,
      "width": 916.15966796875,
      "height": 140,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
