      "link": null,
      "locked": false,
      "text": "3 SYNC CALLBACK -> isme pehele appka callback execute hoga then appka program continues -> dono ek sath hote hai , bas order \n\naffect hoga pehele callback then main code , \n\nisme no dealay ,NOTHing -> turant se sath dono execute ho ajte hai \n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3 SYNC CALLBACK -> isme pehele appka callback execute hoga then appka program continues -> dono ek sath hote hai , bas order \n\naffect hoga pehele callback then main code , \n\nisme no dealay ,NOTHing -> turant se sath dono execute ho ajte hai \n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
