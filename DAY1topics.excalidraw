    {
      "id": "vsrTHdZJRxmkLOe4ehm71",
      "type": "text",
      "x": 28616.541097368507,
      "y": 3001.8226853844626,
      "width": 440.2596740722656,
      "height": 850,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBe",
      "roundness": null,
      "seed": 1365910177,
      "version": 64,
      "versionNonce": 1813718625,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784751084660,
      "link": null,
      "locked": false,
      "text": "1. Callback Functions ✅\nsetTimeout(function () {\n    console.log(\"Hello\");\n}, 1000);\n\n\n\n2. Event Listeners ✅\nbutton.addEventListener(\"click\", function () {\n    console.log(\"Clicked\");\n});\n\n\n\n\n3. Array Methods ✅\narr.map(function (item) {\n    return item * 2;\n});\n\n\n\n4. Promises ✅\nfetchData().then(function (data) {\n    console.log(data);\n});\n\n\n\n\n5. IIFE ✅\n(function () {\n    console.log(\"Only once\");\n})();",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Callback Functions ✅\nsetTimeout(function () {\n    console.log(\"Hello\");\n}, 1000);\n\n\n\n2. Event Listeners ✅\nbutton.addEventListener(\"click\", function () {\n    console.log(\"Clicked\");\n});\n\n\n\n\n3. Array Methods ✅\narr.map(function (item) {\n    return item * 2;\n});\n\n\n\n4. Promises ✅\nfetchData().then(function (data) {\n    console.log(data);\n});\n\n\n\n\n5. IIFE ✅\n(function () {\n    console.log(\"Only once\");\n})();",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9UUrHcKJLJrPyK939kAVv",
      "type": "text",
      "x": 29329.14226313999,
      "y": 2921.643218367195,
      "width": 251.83982849121094,
      "height": 25,
      "angle": 0,
      "strokeColor": "#f08c00",
