      "boundElements": [],
      "updated": 1784163409709,
      "link": null,
      "locked": false,
      "text": "13. Logical NOT (!) → Boolean ko ulta kar deta hai.\n!true\n// false\n\n\n\n14. Double NOT (!!) → Kisi bhi value ko Boolean mein convert karta hai.\n!!\"Hello\"\n// true",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "13. Logical NOT (!) → Boolean ko ulta kar deta hai.\n!true\n// false\n\n\n\n14. Double NOT (!!) → Kisi bhi value ko Boolean mein convert karta hai.\n!!\"Hello\"\n// true",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Y4qeZwCMYwZMgohi5rK3j",
      "type": "text",
