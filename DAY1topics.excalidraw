    {
      "id": "31W-ZFwJMRP2IY1jjkROY",
      "type": "text",
      "x": 63244.23629222238,
      "y": -4252.273464828893,
      "width": 2135.5653076171798,
      "height": 560,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
