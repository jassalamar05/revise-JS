    {
      "id": "4soyioZbUjEXdxdY6mrH9",
      "type": "text",
      "x": 19209.328172229587,
      "y": 7665.696394057507,
      "width": 1931.338623046875,
      "height": 875,
      "angle": 0,
      "strokeColor": "#69db7c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
