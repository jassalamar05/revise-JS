    {
      "id": "AvUp5rTPnFtf6KvlJfHRv",
      "type": "text",
      "x": 28679.504099891292,
      "y": 2402.748624776622,
      "width": 667.3795776367188,
      "height": 175,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
