      "versionNonce": 392398619,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784964535669,
      "link": null,
      "locked": false,
      "text": "| Selector             | Select karta hai   |\n| -------------------- | ------------------ |\n| `h1`                 | Tag                |\n| `#heading`           | ID                 |\n| `.title`             | Class              |\n| `*`                  | Sabhi elements     |\n| `div p`              | div ke andar ke p  |\n| `input[type=\"text\"]` | Attribute selector |\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "| Selector             | Select karta hai   |\n| -------------------- | ------------------ |\n| `h1`                 | Tag                |\n| `#heading`           | ID                 |\n| `.title`             | Class              |\n| `*`                  | Sabhi elements     |\n| `div p`              | div ke andar ke p  |\n| `input[type=\"text\"]` | Attribute selector |\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
