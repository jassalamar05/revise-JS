      "isDeleted": false,
      "boundElements": [],
      "updated": 1784525764557,
      "link": null,
      "locked": false,
      "text": "Pending  →  Work is running ⏳\n\nFulfilled → Success ✅\n\nRejected → Failure ❌ ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pending  →  Work is running ⏳\n\nFulfilled → Success ✅\n\nRejected → Failure ❌ ",
      "autoResize": true,
      "lineHeight": 1.25
    },
