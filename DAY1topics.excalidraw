      "updated": 1784751790975,
      "link": null,
      "locked": false,
      "text": "const person = {\n    name: \"Amar\",\n\n    show: function () {\n\n        console.log(\"1. show() ka this =\", this);\n        // ✅ person\n\n        setTimeout(() => {\n\n            console.log(\"2. Arrow ka this =\", this);\n            // ✅ person\n\n            console.log(this.name);\n            // ✅ Amar\n\n        }, 1000);\n\n    }\n};\n\nperson.show();",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const person = {\n    name: \"Amar\",\n\n    show: function () {\n\n        console.log(\"1. show() ka this =\", this);\n        // ✅ person\n\n        setTimeout(() => {\n\n            console.log(\"2. Arrow ka this =\", this);\n            // ✅ person\n\n            console.log(this.name);\n            // ✅ Amar\n\n        }, 1000);\n\n    }\n};\n\nperson.show();",
      "autoResize": true,
      "lineHeight": 1.25
    },
