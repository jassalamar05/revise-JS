      "versionNonce": 982305985,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784750966784,
      "link": null,
      "locked": false,
      "text": "const greet = function () {\n    console.log(\"Hello\");\n};\n\ngreet();",
      "fontSize": 20,
