      "locked": false,
      "text": "function login() {\n    return Promise.resolve(\"Login Successful\");\n}\n\nfunction getProfile() {\n    return Promise.resolve(\"Profile Loaded\");\n}\n\nfunction getOrders() {\n    return Promise.reject(\"Orders Service Down\");\n}\n\nlogin()\n    .then((msg) => {\n        console.log(msg);\n        return getProfile();\n    })\n    .then((msg) => {\n        console.log(msg);\n        return getOrders();   // ❌ Rejected Promise\n    })\n    .then((msg) => {\n        // Ye execute hi nahi hoga\n        console.log(msg);\n    })\n    .catch((err) => {\n        console.log(\"Error:\", err);\n    })\n    .finally(() => {\n        console.log(\"Process Finished\");\n    });",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function login() {\n    return Promise.resolve(\"Login Successful\");\n}\n\nfunction getProfile() {\n    return Promise.resolve(\"Profile Loaded\");\n}\n\nfunction getOrders() {\n    return Promise.reject(\"Orders Service Down\");\n}\n\nlogin()\n    .then((msg) => {\n        console.log(msg);\n        return getProfile();\n    })\n    .then((msg) => {\n        console.log(msg);\n        return getOrders();   // ❌ Rejected Promise\n    })\n    .then((msg) => {\n        // Ye execute hi nahi hoga\n        console.log(msg);\n    })\n    .catch((err) => {\n        console.log(\"Error:\", err);\n    })\n    .finally(() => {\n        console.log(\"Process Finished\");\n    });",
      "autoResize": true,
      "lineHeight": 1.25
    },
