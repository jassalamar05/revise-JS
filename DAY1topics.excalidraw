      "updated": 1785042127682,
      "link": null,
      "locked": false,
      "text": "appendChild()  → Last me add\nappend()       → Last me add (Text bhi)\nprepend()      → First me add\n\nremoveChild()  → Parent child ko delete kare\nremove()       → Element khud delete ho\n\nreplaceChild() → Parent replace kare\nreplaceWith()  → Element khud replace ho\n\ncloneNode()    → Copy bana do\ninsertBefore() → Kisi ke pehle insert karo",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "appendChild()  → Last me add\nappend()       → Last me add (Text bhi)\nprepend()      → First me add\n\nremoveChild()  → Parent child ko delete kare\nremove()       → Element khud delete ho\n\nreplaceChild() → Parent replace kare\nreplaceWith()  → Element khud replace ho\n\ncloneNode()    → Copy bana do\ninsertBefore() → Kisi ke pehle insert karo",
      "autoResize": true,
      "lineHeight": 1.25
    },
