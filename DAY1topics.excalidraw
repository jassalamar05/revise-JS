    {
      "id": "LtdyUKLhypvrhKuy1k-z3",
      "type": "text",
      "x": 5725.702292091612,
      "y": 10836.719057735483,
      "width": 1054.3955078125,
      "height": 875,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
