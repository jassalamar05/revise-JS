      "isDeleted": false,
      "boundElements": [],
      "updated": 1784163254538,
      "link": null,
      "locked": false,
      "text": "5 > 3      // true\n5 === \"5\"  // false",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5 > 3      // true\n5 === \"5\"  // false",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Xc0onIHBi7PZWKiT_rEQI",
      "type": "text",
      "x": 12244.0428355271,
      "y": 23786.959491892958,
      "width": 1096.36181640625,
      "height": 665,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b7P",
      "roundness": null,
      "seed": 1678941733,
      "version": 12,
      "versionNonce": 628764325,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784163296538,
      "link": null,
      "locked": false,
      "text": "7. Equality (==) → Value compare karta hai (type convert kar sakta hai).\n5 == \"5\"\n// true\n\n\n8. Strict Equality (===) → Value aur type dono compare karta hai.\n5 === \"5\"\n// false\n\n\n9. Inequality (!=) → Values equal nahi hain ya nahi check karta hai.\n5 != \"6\"\n// true\n\n\n\n10. Strict Inequality (!==) → Value ya type different hai ya nahi check karta hai.\n5 !== \"5\"\n// true",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "7. Equality (==) → Value compare karta hai (type convert kar sakta hai).\n5 == \"5\"\n// true\n\n\n8. Strict Equality (===) → Value aur type dono compare karta hai.\n5 === \"5\"\n// false\n\n\n9. Inequality (!=) → Values equal nahi hain ya nahi check karta hai.\n5 != \"6\"\n// true\n\n\n\n10. Strict Inequality (!==) → Value ya type different hai ya nahi check karta hai.\n5 !== \"5\"\n// true",
      "autoResize": true,
      "lineHeight": 1.25
    },
