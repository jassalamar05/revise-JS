    {
      "id": "ypiUNvLRKYbrib3N9E2IE",
      "type": "text",
      "x": 680.0452303052823,
      "y": 7514.085981871685,
      "width": 1053.5222198588185,
      "height": 1665.4946858062194,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aU",
      "roundness": null,
      "seed": 428461583,
      "version": 154,
      "versionNonce": 1731840463,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782689124857,
      "link": null,
      "locked": false,
      "text": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n        SINGLE THREADED\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nDefinition:\nJavaScript ek Single-Threaded language hai,\nyani ek time par sirf ek hi task execute\nkar sakti hai.\n\nMain Points:\n✔ Sirf ek Main Thread hota hai.\n✔ Sirf ek Call Stack hota hai.\n✔ Tasks one-by-one execute hote hain.\n✔ Next task, previous task ke complete\n  hone ke baad hi start hota hai.\n✔ Heavy task aane par Main Thread block\n  ho sakta hai.\n\nFlow:\nTask 1\n   ↓\nTask 2\n   ↓\nTask 3\n   ↓\nTask 4\n\nAdvantages:\n✔ Simple execution\n✔ No race condition\n✔ Easy memory management\n\nDisadvantages:\n✔ Heavy task browser ko block kar sakta hai.\n✔ UI freeze ho sakti hai.\n✔ Async Programming ki zarurat padti hai.\n\nInterview Line:\n\"JavaScript is a Single-Threaded language\nbecause it has one Main Thread and one\nCall Stack, so it executes one task at a\ntime.\"\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
      "fontSize": 30.98594764290642,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n        SINGLE THREADED\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nDefinition:\nJavaScript ek Single-Threaded language hai,\nyani ek time par sirf ek hi task execute\nkar sakti hai.\n\nMain Points:\n✔ Sirf ek Main Thread hota hai.\n✔ Sirf ek Call Stack hota hai.\n✔ Tasks one-by-one execute hote hain.\n✔ Next task, previous task ke complete\n  hone ke baad hi start hota hai.\n✔ Heavy task aane par Main Thread block\n  ho sakta hai.\n\nFlow:\nTask 1\n   ↓\nTask 2\n   ↓\nTask 3\n   ↓\nTask 4\n\nAdvantages:\n✔ Simple execution\n✔ No race condition\n✔ Easy memory management\n\nDisadvantages:\n✔ Heavy task browser ko block kar sakta hai.\n✔ UI freeze ho sakti hai.\n✔ Async Programming ki zarurat padti hai.\n\nInterview Line:\n\"JavaScript is a Single-Threaded language\nbecause it has one Main Thread and one\nCall Stack, so it executes one task at a\ntime.\"\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
      "autoResize": true,
      "lineHeight": 1.25
    },
