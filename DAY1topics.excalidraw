      "isDeleted": false,
      "boundElements": [],
      "updated": 1785035935618,
      "link": null,
      "locked": false,
      "text": "\"Agar browser har time check karta rahe ki button click hua ya nahi, to browser slow ho jayega. Isliye Event System banaya gaya.\"",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Agar browser har time check karta rahe ki button click hua ya nahi, to browser slow ho jayega. Isliye Event System banaya gaya.\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oInQ5fDazA3HWvNuR3wba",
      "type": "text",
      "x": 34531.97803942363,
      "y": 16855.009546778805,
      "width": 829.6957397460938,
      "height": 105,
      "angle": 0,
      "strokeColor": "#4dabf7",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
