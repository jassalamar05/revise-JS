      "boundElements": [],
      "updated": 1785036803579,
      "link": null,
      "locked": false,
      "text": "Real Life Example\n\nJab tum Google pe search karte ho:\n\nGoogle\n\n[                ]\n\nJaise hi search box me click karte ho:\n\n[ |              ]\n\n➡️ Focus Event\n\nAb likhte ho:\n\nc\n\n➡️ Input Event\n\nch\n\n➡️ Input Event\n\nchatgpt\n\n➡️ Har letter par Input Even",
