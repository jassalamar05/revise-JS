    },
    {
      "id": "Ey069merWDY9Df6tHbJNp",
      "type": "text",
      "x": 45892.02171979436,
      "y": 1317.9777870637354,
      "width": 1849.8923248536887,
      "height": 93.28170776367183,
      "angle": 0,
      "strokeColor": "#7950f2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKL",
      "roundness": null,
      "seed": 268220293,
      "version": 109,
      "versionNonce": 286086443,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785498353877,
      "link": null,
      "locked": false,
      "text": "Prototype Chain is the mechanism by which JavaScript searches for a property or method. If it is not found in the current object, JavaScript follows\n\n the __proto__ link to the next prototype object, and continues this process until the property is found or null is reached.",
      "fontSize": 24.87512207031249,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Prototype Chain is the mechanism by which JavaScript searches for a property or method. If it is not found in the current object, JavaScript follows\n\n the __proto__ link to the next prototype object, and continues this process until the property is found or null is reached.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "XbEGVRDr8bZ8H_izCkP-b",
      "type": "text",
      "x": 46337.12820123161,
      "y": 1484.8647601268867,
      "width": 321.35589599609375,
      "height": 560,
      "angle": 0,
      "strokeColor": "#7950f2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKM",
      "roundness": null,
      "seed": 2100707595,
