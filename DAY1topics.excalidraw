    {
      "id": "oOMHedmYI48Xjt4jtiFrU",
      "type": "text",
      "x": 43028.19594598634,
      "y": -4205.844715083137,
      "width": 1382.4852276230304,
      "height": 775,
      "angle": 0,
      "strokeColor": "#da77f2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
