      "seed": 687411435,
      "version": 3,
      "versionNonce": 940423685,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785501037004,
      "link": null,
      "locked": false,
      "text": "Ab newObj ke andar kya hai?\n\nnewObj = {}\n\nIske andar constructor property nahi hai.\n\nBas iska hidden prototype (__proto__) Animal.prototype ko point kar raha hai.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ab newObj ke andar kya hai?\n\nnewObj = {}\n\nIske andar constructor property nahi hai.\n\nBas iska hidden prototype (__proto__) Animal.prototype ko point kar raha hai.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tvH9ZypTNITwPcLUplc0q",
      "type": "text",
      "x": 48946.61296050433,
      "y": 6457.032139702727,
      "width": 302.00787353515625,
      "height": 350,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bLL",
      "roundness": null,
      "seed": 1678136363,
      "version": 37,
      "versionNonce": 321003749,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785501055708,
      "link": null,
      "locked": false,
      "text": "newObj\n{}\n │\n │ __proto__\n ▼\nAnimal.prototype\n{\n   constructor: Animal,\n   eat: function(){}\n}",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "newObj\n{}\n │\n │ __proto__\n ▼\nAnimal.prototype\n{\n   constructor: Animal,\n   eat: function(){}\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
