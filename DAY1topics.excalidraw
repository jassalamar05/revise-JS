    {
      "id": "jlSsmWCHyCl6NgqiNzGOA",
      "type": "text",
      "x": 22161.028358459473,
      "y": 4438.327412923177,
      "width": 948.099365234375,
      "height": 225,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9N",
      "roundness": null,
      "seed": 1703407471,
      "version": 451,
      "versionNonce": 1607755841,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784581460235,
      "link": null,
      "locked": false,
      "text": "promise construcotre -> yeh appka intial phase hai jaha par PROMISE OBJ create karta hai . \n\njab bhi ham aise likjte hai new Promise ===== iska matalb hai ke ek promise obj create ho gya hai \n\n{ \nstate : pending ,\nvalue :null\n}\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "promise construcotre -> yeh appka intial phase hai jaha par PROMISE OBJ create karta hai . \n\njab bhi ham aise likjte hai new Promise ===== iska matalb hai ke ek promise obj create ho gya hai \n\n{ \nstate : pending ,\nvalue :null\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QTxZ_qskTnWl2hVBdlLem",
