      "isDeleted": false,
      "boundElements": [],
      "updated": 1785035956683,
      "link": null,
      "locked": false,
      "text": "while (true) {\n\n    // Kya button click hua?\n\n    // Kya button click hua?\n\n    // Kya button click hua?\n\n    // Kya button click hua?\n\n}",
      "fontSize": 28,
