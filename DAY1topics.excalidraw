    {
      "id": "_r_5riVH8ONNi7RL6yqKq",
      "type": "text",
      "x": 3082.0620096812063,
      "y": 176.50241002408558,
      "width": 1088.439208984375,
      "height": 350,
      "angle": 0,
      "strokeColor": "#da77f2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ah",
      "roundness": null,
      "seed": 1043203696,
      "version": 607,
      "versionNonce": 936574096,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1782773245816,
      "link": null,
      "locked": false,
      "text": "WHy :  abb scoho ke maine memory and Exeecution kya kar rhae hai \n\nMemory kya kar rhaa hai :: suppose tune ek js ka program banaya hai okay ,\nab asia toh nai hai ke woh bina storage hi chal jayega , -> kahi na kahi usko memory chahiye taaki woh appne,\nvaraibels , fucntions store kar sake \n\n\n\nExecution : iska matalb hai ke kaise hamne storage space bana li hai but bina execution ke kya hi karna hai iska\nToh thats what we need after stroing it is execution \n\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHy :  abb scoho ke maine memory and Exeecution kya kar rhae hai \n\nMemory kya kar rhaa hai :: suppose tune ek js ka program banaya hai okay ,\nab asia toh nai hai ke woh bina storage hi chal jayega , -> kahi na kahi usko memory chahiye taaki woh appne,\nvaraibels , fucntions store kar sake \n\n\n\nExecution : iska matalb hai ke kaise hamne storage space bana li hai but bina execution ke kya hi karna hai iska\nToh thats what we need after stroing it is execution \n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
