      "updated": 1784964518572,
      "link": null,
      "locked": false,
      "text": "HTML\n   ↓\nCSS Selector\n   ↓\nElement Select\n   ↓\nCSS Style Apply\n   ↓\nWeb Page Styled",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HTML\n   ↓\nCSS Selector\n   ↓\nElement Select\n   ↓\nCSS Style Apply\n   ↓\nWeb Page Styled",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "M3T-8l6vP0DiZRW_83_hg",
      "type": "text",
      "x": 35582.40383593242,
      "y": 6939.553058588956,
      "width": 608.1317138671875,
      "height": 315,
      "angle": 0,
      "strokeColor": "#da77f2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
