      "type": "text",
      "x": 31643.908742597207,
      "y": 2108.1975265111937,
      "width": 2311.5947265625,
      "height": 1260,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
