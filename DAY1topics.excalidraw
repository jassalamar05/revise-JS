      "locked": false,
      "text": "async function main() {\n    const data = await fetchData();\n    console.log(data);\n}\n\nmain();\n\nconsole.log(\"End\");",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "async function main() {\n    const data = await fetchData();\n    console.log(data);\n}\n\nmain();\n\nconsole.log(\"End\");",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Dr0ABKSDkqLACzloAgR5G",
      "type": "text",
      "x": 26429.12074027968,
      "y": 12501.210742696134,
      "width": 484.51177978515625,
      "height": 1015,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
