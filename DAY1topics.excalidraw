      "locked": false,
      "text": "class Student\n        │\n        ▼\nMemory mein class register\n\n        │\n        ▼\nnew Student(\"Amar\",21)\n\n        │\n        ▼\n1. Empty Object Create\n{}\n\n        │\n        ▼\n2. __proto__ → Student.prototype set\n\n        │\n        ▼\n3. Constructor Automatically Call\n\n        │\n        ▼\n4. this → Empty Object\n\n        │\n        ▼\n5. this.name = \"Amar\"\n   this.age = 21\n\n        │\n        ▼\n6. Constructor Finish\n\n        │\n        ▼\n7. JavaScript Automatically return this\n\n        │\n        ▼\n8. Returned Object → s1",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Student\n        │\n        ▼\nMemory mein class register\n\n        │\n        ▼\nnew Student(\"Amar\",21)\n\n        │\n        ▼\n1. Empty Object Create\n{}\n\n        │\n        ▼\n2. __proto__ → Student.prototype set\n\n        │\n        ▼\n3. Constructor Automatically Call\n\n        │\n        ▼\n4. this → Empty Object\n\n        │\n        ▼\n5. this.name = \"Amar\"\n   this.age = 21\n\n        │\n        ▼\n6. Constructor Finish\n\n        │\n        ▼\n7. JavaScript Automatically return this\n\n        │\n        ▼\n8. Returned Object → s1",
      "autoResize": true,
