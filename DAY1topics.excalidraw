      "isDeleted": false,
      "boundElements": [],
      "updated": 1784059176879,
      "link": null,
      "locked": false,
      "text": "let :: it is global scoped + fun+ block scoped in nature .\n\nin let you can declare , asssign , re assign but you cannot re declare the varubale with same name\n\n\n\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "let :: it is global scoped + fun+ block scoped in nature .\n\nin let you can declare , asssign , re assign but you cannot re declare the varubale with same name\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
