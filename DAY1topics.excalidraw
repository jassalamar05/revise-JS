      "updated": 1784753800402,
      "link": null,
      "locked": false,
      "text": "Default Parameter\nfunction greet(name = \"Guest\") {\n    console.log(name);\n}\n\ngreet();\ngreet(\"Amar\");\n\nOutput\n\nGuest\nAmar\n\n👉 Agar value pass nahi hui, to \"Guest\" use",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Default Parameter\nfunction greet(name = \"Guest\") {\n    console.log(name);\n}\n\ngreet();\ngreet(\"Amar\");\n\nOutput\n\nGuest\nAmar\n\n👉 Agar value pass nahi hui, to \"Guest\" use",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wV76DvBpoe8WDw0Wboq8J",
      "type": "text",
      "x": 30976.842165429014,
