      "link": null,
      "locked": false,
      "text": "function greet(name, callback) {\n    console.log(\"Hello\", name);\n\n    callback(); // Turant call\n}\n\nfunction sayBye() {\n    console.log(\"Bye\");\n}\n\ngreet(\"Amar\", sayBye);\n\nconsole.log(\"Done\");",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function greet(name, callback) {\n    console.log(\"Hello\", name);\n\n    callback(); // Turant call\n}\n\nfunction sayBye() {\n    console.log(\"Bye\");\n}\n\ngreet(\"Amar\", sayBye);\n\nconsole.log(\"Done\");",
      "autoResize": true,
      "lineHeight": 1.25
    },
