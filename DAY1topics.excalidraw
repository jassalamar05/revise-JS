    {
      "id": "omBUsYZUyfu9ysflYPYRP",
      "type": "text",
      "x": 22164.326793909746,
      "y": 14734.680723136855,
      "width": 2155.978759765625,
      "height": 425,
      "angle": 0,
      "strokeColor": "#da77f2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9w",
