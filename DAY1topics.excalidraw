      "boundElements": [],
      "updated": 1784753870091,
      "link": null,
      "locked": false,
      "text": "Group 4 - Function Scope ⭐⭐⭐⭐\nIIFE (Immediately Invoked Function Expression)\n\nYe batata hai function ko turant execute kaise karte hain aur private scope kyu banate hain.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Group 4 - Function Scope ⭐⭐⭐⭐\nIIFE (Immediately Invoked Function Expression)\n\nYe batata hai function ko turant execute kaise karte hain aur private scope kyu banate hain.",
      "autoResize": true,
      "lineHeight": 1.25
    },
