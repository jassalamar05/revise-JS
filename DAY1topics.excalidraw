    {
      "id": "r-rlr5n6g2414fsI2u7YX",
      "type": "text",
      "x": 34595.15543810527,
      "y": 12718.702306133731,
      "width": 1654.4349365234375,
      "height": 280,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
