      "text": "Protype chaining ::\n \n  ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Protype chaining ::\n \n  ",
