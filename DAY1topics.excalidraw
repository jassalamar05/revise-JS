      "link": null,
      "locked": false,
      "text": "Focus ka matlab hai: \"Ab keyboard ka control is element ke paas aa gaya hai.\"\n\nJab input active ho jata hai aur usme cursor aa jata hai, tab focus event fire hota hai.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Focus ka matlab hai: \"Ab keyboard ka control is element ke paas aa gaya hai.\"\n\nJab input active ho jata hai aur usme cursor aa jata hai, tab focus event fire hota hai.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
