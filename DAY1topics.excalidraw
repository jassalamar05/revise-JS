      "updated": 1784583534235,
      "link": null,
      "locked": false,
      "text": "const promise = new Promise((resolve, reject) => {\n\n    setTimeout(() => {\n        resolve(\"Data\");\n    }, 2000);\n\n});",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const promise = new Promise((resolve, reject) => {\n\n    setTimeout(() => {\n        resolve(\"Data\");\n    }, 2000);\n\n});",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hRG0uSgsA1K9vcuAn5yrt",
