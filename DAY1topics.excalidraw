    {
      "id": "I-KMENvZheIi0Xu4GOT4j",
      "type": "text",
      "x": 7235.6386931587795,
      "y": 3445.717241188355,
      "width": 939.8642809383996,
      "height": 385,
      "angle": 0,
      "strokeColor": "#1971c2",
