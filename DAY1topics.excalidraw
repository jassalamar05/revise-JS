    {
      "id": "0Dpf51QDTTFJi7UGpbHj4",
      "type": "text",
      "x": 29063.806569780605,
      "y": 4586.110716512183,
      "width": 283.8998107910156,
      "height": 475,
      "angle": 0,
      "strokeColor": "#ff8787",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
