      "updated": 1784964502662,
      "link": null,
      "locked": false,
      "text": "Kaam (Purpose)\nHTML element ko identify (select) karta hai.\nSelected element par CSS properties apply karta hai.\nEk ya ek se zyada elements ko style kar sakta hai.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kaam (Purpose)\nHTML element ko identify (select) karta hai.\nSelected element par CSS properties apply karta hai.\nEk ya ek se zyada elements ko style kar sakta hai.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "U8H9TZ-mWyRt8GeTPI3Ab",
      "type": "text",
      "x": 35026.848385492965,
      "y": 6941.775348628019,
