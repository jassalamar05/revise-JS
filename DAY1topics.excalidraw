    {
      "id": "yY-JdXD3lMCGoERMm3yJB",
      "type": "text",
      "x": 38121.414656632456,
      "y": -4255.585698836474,
      "width": 2203.530517578125,
      "height": 240.3147562953663,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
