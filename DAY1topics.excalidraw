      "versionNonce": 1590606277,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785496550755,
      "link": null,
      "locked": false,
      "text": "Student (Function/Class)\n\n{\n    prototype  ───────────────┐\n}                             │\n                              ▼\n                     Student.prototype\n                     {\n                        constructor → Student\n                        study()\n                        play()\n                     }",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Student (Function/Class)\n\n{\n    prototype  ───────────────┐\n}                             │\n                              ▼\n                     Student.prototype\n                     {\n                        constructor → Student\n                        study()\n                        play()\n                     }",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
