      "seed": 1250239941,
      "version": 489,
      "versionNonce": 75727179,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785495757811,
      "link": null,
      "locked": false,
      "text": "abb suppose karo ke proto ko -> Student.prototype  mei se mehtod nai milla jo usko chahiye -> \n\nabb agge chaining kaise hogi then student prototype kahega let me se in my parent fucntion \n\nS.prototype appka ._proto_ labega and further jayega to top most parnt fucntion \n\nie your OBJECT PROTOTYPE agar usme nai milla toh null show kardega  \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "abb suppose karo ke proto ko -> Student.prototype  mei se mehtod nai milla jo usko chahiye -> \n\nabb agge chaining kaise hogi then student prototype kahega let me se in my parent fucntion \n\nS.prototype appka ._proto_ labega and further jayega to top most parnt fucntion \n\nie your OBJECT PROTOTYPE agar usme nai milla toh null show kardega  \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
