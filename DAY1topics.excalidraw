    {
      "id": "DayOXu2U51jFKt3V3AJeY",
      "type": "text",
      "x": 53417.95387121741,
      "y": 3373.3642019553404,
      "width": 1235.841796875,
      "height": 528.1607491629467,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
