      "boundElements": [],
      "updated": 1784755416706,
      "link": null,
      "locked": false,
      "text": "next()\n\n↓\n\nyield 1\n\n↓\n\nPause\n\n↓\n\nnext()\n\n↓\n\nyield 2\n\n↓\n\nPause\n\n↓\n\nnext()\n\n↓\n\nyield 3",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
