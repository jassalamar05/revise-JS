      "updated": 1785506157034,
      "link": null,
      "locked": false,
      "text": "function Student(name) {\n    this.name = name;\n}\n\nStudent.prototype.study = function () {\n    console.log(`${this.name} is studying`);\n};\n\nconst s1 = new Student(\"Amar\");\nconst s2 = new Student(\"Rahul\");",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function Student(name) {\n    this.name = name;\n}\n\nStudent.prototype.study = function () {\n    console.log(`${this.name} is studying`);\n};\n\nconst s1 = new Student(\"Amar\");\nconst s2 = new Student(\"Rahul\");",
      "autoResize": true,
      "lineHeight": 1.25
    },
