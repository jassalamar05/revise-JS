    },
    {
      "id": "nzNnmqEXce5gzo1pg4Zba",
      "type": "arrow",
      "x": 62934.022056279704,
      "y": -6877.215531426626,
      "width": 150.5425262451172,
      "height": 22.786407470703125,
      "angle": 0,
      "strokeColor": "#2f9e44",
