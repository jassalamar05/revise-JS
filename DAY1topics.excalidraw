    {
      "id": "suNfcGyWV-u-o0td6QqeV",
      "type": "text",
      "x": 22215.242855311113,
      "y": 13527.606240188157,
      "width": 2113.863037109373,
      "height": 1025,
      "angle": 0,
      "strokeColor": "#d2bab0",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9t",
