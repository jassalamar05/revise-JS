    {
      "id": "yEGmrKYX7hEDUTMjmAkKv",
      "type": "text",
      "x": 45922.87054606802,
      "y": -4016.333119514834,
      "width": 1637.130859375,
      "height": 455,
      "angle": 0,
      "strokeColor": "#da77f2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJJ",
      "roundness": null,
      "seed": 1097173317,
      "version": 577,
      "versionNonce": 199737739,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785496756003,
      "link": null,
      "locked": false,
      "text": "hidden link hai jo har object mei hota hai , isi se prototype chaining possible htoi hai , \n\nyeh obejct ki property hai jo appka uss obejct ke parent obejct se link banati hai that is __proto__.\n\nRule ::\n\n\nAgar appko obejct ki cheeze uski ke parent mei  mil jaye tohj __proto __ kineed nai padti but \n\nagar aisa na ho then appka obejctPrototype mei kuch dhudna tak ki nobbat a jaye toh proto hi waha tak leke jata ahi \n\n\nkyoki har objet mei proto hota hai uske parent ka ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "hidden link hai jo har object mei hota hai , isi se prototype chaining possible htoi hai , \n\nyeh obejct ki property hai jo appka uss obejct ke parent obejct se link banati hai that is __proto__.\n\nRule ::\n\n\nAgar appko obejct ki cheeze uski ke parent mei  mil jaye tohj __proto __ kineed nai padti but \n\nagar aisa na ho then appka obejctPrototype mei kuch dhudna tak ki nobbat a jaye toh proto hi waha tak leke jata ahi \n\n\nkyoki har objet mei proto hota hai uske parent ka ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Wc5DILunQCnrTy6uv3uh5",
      "type": "text",
      "x": 46429.3721714066,
      "y": -3529.3459305456668,
      "width": 90.8435914083461,
      "height": 702.7082061767578,
      "angle": 0,
      "strokeColor": "#da77f2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJq",
      "roundness": null,
      "seed": 837650597,
      "version": 151,
      "versionNonce": 1118090341,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785496855327,
      "link": null,
      "locked": false,
      "text": "Current Object\n\n↓\n\nProperty Found?\n\n│\n\n├── Yes ✅ → Stop\n\n│\n\n└── No ❌\n\n↓\n\n__proto__\n\n↓\n\nPrototype Object\n\n↓\n\nProperty Found?\n\n│\n\n├── Yes ✅ → Stop\n\n│\n\n└── No ❌\n\n↓\n\nNext __proto__\n\n↓\n\nObject.prototype\n\n↓\n\nFound?\n\n│\n\n├── Yes ✅\n\n│\n\n└── No ❌\n\n↓\n\nnull\n\n↓\n\nTypeError",
      "fontSize": 9.21584532690831,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Current Object\n\n↓\n\nProperty Found?\n\n│\n\n├── Yes ✅ → Stop\n\n│\n\n└── No ❌\n\n↓\n\n__proto__\n\n↓\n\nPrototype Object\n\n↓\n\nProperty Found?\n\n│\n\n├── Yes ✅ → Stop\n\n│\n\n└── No ❌\n\n↓\n\nNext __proto__\n\n↓\n\nObject.prototype\n\n↓\n\nFound?\n\n│\n\n├── Yes ✅\n\n│\n\n└── No ❌\n\n↓\n\nnull\n\n↓\n\nTypeError",
      "autoResize": true,
      "lineHeight": 1.25
    },
