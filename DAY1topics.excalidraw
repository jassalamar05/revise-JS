    {
      "id": "_fERX6fkYPi1J7zNMjkKM",
      "type": "text",
      "x": 48716.17893950824,
      "y": 6156.372356047985,
      "width": 1087.8834228515625,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
