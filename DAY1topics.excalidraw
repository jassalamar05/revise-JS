      "boundElements": [],
      "updated": 1784158824678,
      "link": null,
      "locked": false,
      "text": "To primitivee :: ab se jab appke pass primitive data nai milla appko then , appko mila suppose object , array , date , fuction abb usko kaise compare kaerga \n\nsoo data appka primitive karna padega -> supoose usko abb convert karna padega and woh hoga usjing TOprimitive algo.\n\n\n\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "To primitivee :: ab se jab appke pass primitive data nai milla appko then , appko mila suppose object , array , date , fuction abb usko kaise compare kaerga \n\nsoo data appka primitive karna padega -> supoose usko abb convert karna padega and woh hoga usjing TOprimitive algo.\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "iiTXT5klCssDCCAjuiWyN",
      "type": "text",
      "x": 13485.493243741457,
