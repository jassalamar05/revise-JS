    {
      "id": "8Inb0etMnfF3g3mnlkHDo",
      "type": "text",
      "x": 19688.851705641973,
      "y": 5084.862931387771,
      "width": 423.6606750488281,
      "height": 150,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8b",
      "roundness": null,
      "seed": 1263975276,
      "version": 4,
      "versionNonce": 1612191724,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784512072941,
      "link": null,
      "locked": false,
      "text": "Error-First Callback ki Characteristics\n✅ Pehla parameter hamesha err\n✅ Success me err = null\n✅ Failure me err = Error Object\n✅ Doosra parameter result/data hota hai.\n✅ Ye Node.js ka standard convention hai.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Error-First Callback ki Characteristics\n✅ Pehla parameter hamesha err\n✅ Success me err = null\n✅ Failure me err = Error Object\n✅ Doosra parameter result/data hota hai.\n✅ Ye Node.js ka standard convention hai.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kg8IX_kiQmzul74_-IZgt",
      "type": "text",
      "x": 19624.68506440662,
      "y": 5312.362944103429,
      "width": 901.059326171875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8c",
      "roundness": null,
      "seed": 1845004244,
      "version": 6,
      "versionNonce": 1023369452,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784512099061,
      "link": null,
      "locked": false,
      "text": "Interview Definition\n\nError-First Callback is a Node.js convention where the callback function\n receives the error as the first argument and the successful result as the second argument.\n If the operation succeeds, the error is null; otherwise, it contains an Error object.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Interview Definition\n\nError-First Callback is a Node.js convention where the callback function\n receives the error as the first argument and the successful result as the second argument.\n If the operation succeeds, the error is null; otherwise, it contains an Error object.",
      "autoResize": true,
      "lineHeight": 1.25
    },
