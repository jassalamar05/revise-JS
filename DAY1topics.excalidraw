      "versionNonce": 1263281125,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785498370422,
      "link": null,
      "locked": false,
      "text": "              s1\n               │\n          __proto__\n               │\n               ▼\n      Student.prototype\n               │\n          __proto__\n               │\n               ▼\n      Object.prototype\n               │\n          __proto__\n               │\n               ▼\n              null",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "              s1\n               │\n          __proto__\n               │\n               ▼\n      Student.prototype\n               │\n          __proto__\n               │\n               ▼\n      Object.prototype\n               │\n          __proto__\n               │\n               ▼\n              null",
      "autoResize": true,
      "lineHeight": 1.25
    },
