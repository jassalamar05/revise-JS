      "updated": 1784753824161,
      "link": null,
      "locked": false,
      "text": "Rest Parameter\nfunction sum(...nums) {\n    console.log(nums);\n}\n\nsum(10, 20, 30, 40);\n\nOutput\n\n[10, 20, 30, 40]\n\n👉 Sare arguments ek array me aa gaye.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rest Parameter\nfunction sum(...nums) {\n    console.log(nums);\n}\n\nsum(10, 20, 30, 40);\n\nOutput\n\n[10, 20, 30, 40]\n\n👉 Sare arguments ek array me aa gaye.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
