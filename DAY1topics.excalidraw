      "updated": 1784511832764,
      "link": null,
      "locked": false,
      "text": "ASYNC Callback : yeh appka callback ki wait nai krta -> main program starts execuition jab bhi appka callback finish hogha yeh callback ko call karega .\n\nissse appka thread block nai hota hai :::\n\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ASYNC Callback : yeh appka callback ki wait nai krta -> main program starts execuition jab bhi appka callback finish hogha yeh callback ko call karega .\n\nissse appka thread block nai hota hai :::\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_hL4TkzGhO6Ksa8yWStX2",
      "type": "text",
      "x": 19801.47072419666,
