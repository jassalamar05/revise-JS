      "version": 3,
      "versionNonce": 1114010773,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785035950223,
      "link": null,
      "locked": false,
      "text": "Aur browser ko dekhna hai ki user ne click kiya ya nahi.\n\nAgar event system na hota, to browser ko aisa karna padta:",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aur browser ko dekhna hai ki user ne click kiya ya nahi.\n\nAgar event system na hota, to browser ko aisa karna padta:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
