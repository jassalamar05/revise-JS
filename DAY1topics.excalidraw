      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "After ES6\n\nSolution:\n\nShort syntax ✅\nLexical this ✅\nCleaner callbacks ✅",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
