      "seed": 1520234100,
      "version": 64,
      "versionNonce": 1583177716,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784879274333,
      "link": null,
      "locked": false,
      "text": "Number = 12345\n\n↓\n\nDigits = 5\n\n↓\n\nMath.floor(5 / 2) = 2\n\n↓\n\n10² = 100\n\n↓\n\n12345 / 100 = 123.45\n\n↓\n\nMath.floor = 123\n\n↓\n\n123 % 10 = 3",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Number = 12345\n\n↓\n\nDigits = 5\n\n↓\n\nMath.floor(5 / 2) = 2\n\n↓\n\n10² = 100\n\n↓\n\n12345 / 100 = 123.45\n\n↓\n\nMath.floor = 123\n\n↓\n\n123 % 10 = 3",
      "autoResize": true,
      "lineHeight": 1.25
    },
