      "updated": 1784879234917,
      "link": null,
      "locked": false,
      "text": "function middleDigit(number) {\n\n    let temp = number;\n    let digits = 0;\n\n    while (temp > 0) {\n        digits++;\n        temp = Math.floor(temp / 10);\n    }\n\n    let divideBy = 10 ** Math.floor(digits / 2);\n\n    return Math.floor(number / divideBy) % 10;\n}\n\nconsole.log(middleDigit(12345)); // 3",
      "fontSize": 15.355199227546976,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function middleDigit(number) {\n\n    let temp = number;\n    let digits = 0;\n\n    while (temp > 0) {\n        digits++;\n        temp = Math.floor(temp / 10);\n    }\n\n    let divideBy = 10 ** Math.floor(digits / 2);\n\n    return Math.floor(number / divideBy) % 10;\n}\n\nconsole.log(middleDigit(12345)); // 3",
      "autoResize": true,
      "lineHeight": 1.25
    },
